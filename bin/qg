#!/usr/bin/env bash
# qg — evidencia de verificación para agent-quality-gate.
#
# Subcomandos:
#   qg fingerprint [--json]                         huella del contenido actual del repositorio
#   qg run [opciones] <check-id> -- <cmd> [args…]  ejecuta UN comando y registra evidencia
#      [--baseline <ruta> --baseline-format typescript]  compara los diagnósticos con una línea base
#   qg baseline write --format typescript --output <ruta> [--replace] -- <cmd> [args…]
#                                                   crea la línea base de diagnósticos heredados
#   qg require [--run-id ID] [--clear] [<id>…]      declara las verificaciones obligatorias (por sesión)
#   qg status [--require ID]… [--run-id ID] [--json]  ¿hay evidencia vigente para el estado actual?
#   qg reject [--run-id ID] <check-id> --reason R   descarta la última evidencia (p. ej. exit 0 sin pruebas)
#   qg classify [--json] -- <cmd> [args…]           clase de efectos secundarios antes de ejecutar (solo lee)
#   qg version [--json]                             versión e interfaz
#   qg session id|start|info|stop …                 estado de sesiones de Claude Code (hooks)
#   qg hooks status [--json] | enabled <hook>       activación voluntaria de los hooks
#   qg show [<check-id>]                            lista los registros
#   qg gc                                           limpia temporales, cuarentena, sesiones antiguas
# Opción global: -C <dir> (como git -C).
#
# Requisitos: bash >= 3.2 y git >= 2.25. Sin jq, Node ni Python.
# Documentación: docs/evidencia.md

QG_VERSION="0.2.0-dev"
QG_SCHEMA=1
# Interfaz (solo ampliaciones): 2: require/status por sesión, reject, version · 3: session, hooks
# 4: líneas base de diagnósticos (run --baseline, baseline write, objeto "baseline" y
#    "baseline_checks" en status --json) · classify (clasificación previa, no ejecuta nada)
QG_INTERFACE=4
EX_USAGE=64
EX_STATE=65
QG_ID_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
QG_REASON_RE='^[a-z0-9][a-z0-9_-]{0,63}$'
QG_RUNID_RE='^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$'
QG_FP_RE='^(sha1|sha256):[0-9a-f]{40}([0-9a-f]{24})?$'
QG_KEEP_RECORDS="${QG_KEEP_RECORDS:-50}"

umask 077

# ---------------------------------------------------------------- utilidades

qg_err()   { printf 'qg: %s\n' "$*" >&2; }
qg_die()   { local code=$1; shift; qg_err "$@"; exit "$code"; }
qg_usage() { qg_die "$EX_USAGE" "$* (ver: qg help)"; }

qg_now_iso()   { date -u +%Y-%m-%dT%H:%M:%SZ; }
qg_now_epoch() { date +%s; }
qg_host()      { hostname 2>/dev/null || uname -n 2>/dev/null || echo unknown; }

# Escapa un valor para una línea key=value (sin saltos de línea).
qg_esc() {
  local v=$1
  v=${v//\\/\\\\}
  v=${v//$'\n'/\\n}
  v=${v//$'\r'/\\r}
  printf '%s' "$v"
}

# Cadena JSON. Los valores ya vienen escapados por qg_esc o validados por regex.
qg_json_str() {
  local v=$1
  v=${v//\\/\\\\}
  v=${v//\"/\\\"}
  v=${v//$'\t'/\\t}
  v=$(printf '%s' "$v" | tr -d '\000-\010\012-\037')
  printf '"%s"' "$v"
}

qg_is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

# Redacta argumentos que parecen secretos: --token=x, PASSWORD=x, --api-key x, https://u:p@host
qg_redact_argv() {
  local out="" a skip_next=0 r
  local secret='(token|secret|passw(or)?d|pwd|api[_-]?key|auth|credential|private[_-]?key|bearer)'
  shopt -s nocasematch
  for a in "$@"; do
    if [ "$skip_next" = 1 ]; then
      r=REDACTED; skip_next=0
    elif [[ $a =~ ^(-{0,2}[A-Za-z0-9_.-]*${secret}[A-Za-z0-9_.-]*)=.+$ ]]; then
      r="${BASH_REMATCH[1]}=REDACTED"
    elif [[ $a =~ ^-{1,2}[A-Za-z0-9_.-]*${secret}[A-Za-z0-9_.-]*$ ]]; then
      r=$a; skip_next=1
    elif [[ $a =~ ^([A-Za-z][A-Za-z0-9+.-]*://[^/:@]+):[^/@]+@(.*)$ ]]; then
      r="${BASH_REMATCH[1]}:REDACTED@${BASH_REMATCH[2]}"
    else
      r=$a
    fi
    out="$out${out:+ }$(printf '%q' "$r")"
  done
  shopt -u nocasematch
  printf '%s' "$out"
}

# Resuelve -C y deja el directorio de trabajo.
QG_ARGS=()
qg_parse_global() {
  QG_ARGS=()
  while [ $# -gt 0 ]; do
    case $1 in
      -C) [ $# -ge 2 ] || qg_usage "-C requiere un directorio"
          cd -- "$2" 2>/dev/null || qg_die "$EX_STATE" "no se puede entrar en '$2'"
          shift 2 ;;
      *) QG_ARGS=("$@"); return ;;
    esac
  done
}

# ---------------------------------------------------------------- Git y estado

qg_git_init() {
  command -v git >/dev/null 2>&1 || qg_die "$EX_STATE" "git no está instalado: no se puede calcular una huella"
  if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" != true ]; then
    qg_die "$EX_STATE" "no es un repositorio Git con working tree: qg no puede garantizar una huella confiable (limitación de esta versión)"
  fi
  QG_TOP=$(git rev-parse --show-toplevel) || qg_die "$EX_STATE" "no se pudo resolver la raíz del repositorio"
  local p
  p=$(git rev-parse --git-path quality-gate) || qg_die "$EX_STATE" "no se pudo resolver el directorio de estado"
  case $p in /*) ;; *) p="$PWD/$p" ;; esac
  QG_STATE_ROOT=$p
  QG_STATE="$p/v$QG_SCHEMA"
}

qg_state_init() {
  local d
  for d in "$QG_STATE_ROOT" "$QG_STATE" "$QG_STATE/records"; do
    if [ -L "$d" ]; then qg_die "$EX_STATE" "el directorio de estado '$d' es un enlace simbólico; se rechaza por seguridad"; fi
    if [ ! -d "$d" ]; then mkdir "$d" 2>/dev/null || [ -d "$d" ] || qg_die "$EX_STATE" "no se pudo crear '$d'"; fi
  done
}

qg_check_dir() {
  local d="$QG_STATE/records/$1"
  if [ -L "$d" ]; then qg_die "$EX_STATE" "'$d' es un enlace simbólico; se rechaza"; fi
  printf '%s' "$d"
}

# Huella: árbol Git del contenido del working tree (versionados + no versionados no ignorados),
# calculado con un índice y un almacén de objetos temporales SIN el almacén real como alternativo
# (write-tree --missing-ok): no modifica el índice ni .git/objects, ni siquiera el mtime de los
# objetos existentes (git los "refresca" si los encuentra en un almacén alternativo).
# Define QG_FP, QG_FP_INDEX (lo que entraría en un commit) y QG_HEAD.
# La huella es una instantánea: si otro proceso crea o borra archivos mientras `git add` los
# recorre ("unable to stat"), se reintenta. Solo se informa el error si fallan todos los intentos.
qg_fp_compute() {
  local attempt QG_FP_QUIET=1
  for attempt in 1 2 3 4 5; do
    [ "$attempt" = 5 ] && QG_FP_QUIET=0
    qg_fp_compute_once && return 0
    sleep "0.$attempt" 2>/dev/null || sleep 1
  done
  return 1
}

qg_fp_compute_once() {
  local tmp idx fmt wt it empty
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/qg-fp.XXXXXX") || return 1
  mkdir "$tmp/obj" || { rm -rf "$tmp"; return 1; }
  idx=$(git rev-parse --git-path index) || { rm -rf "$tmp"; return 1; }
  fmt=$(git rev-parse --show-object-format 2>/dev/null) || fmt=sha1
  empty=$(git hash-object --no-filters -t tree /dev/null) || { rm -rf "$tmp"; return 1; }
  # Neutraliza los filtros clean/process configurados (p. ej. git-lfs o filtros propios): calcular la
  # huella no debe ejecutar procesos externos ni producir efectos secundarios. Se aplica a TODOS los
  # comandos git de este cálculo: write-tree también ejecuta el filtro al comprobar entradas "racy". Los archivos con
  # filtro que cambian se identifican por su contenido sin filtrar (ver docs/evidencia.md).
  local nf=() key drv seen=" "
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    drv=${key#filter.}; drv=${drv%.*}
    case $drv in ""|*=*) continue ;; esac
    case $seen in *" $drv "*) continue ;; esac
    seen="$seen$drv "
    nf+=(-c "filter.$drv.clean=" -c "filter.$drv.process=" -c "filter.$drv.required=false")
  done <<EOF_FILTERS
$(git config --name-only --get-regexp '^filter[.]' 2>/dev/null)
EOF_FILTERS
  if [ -f "$idx" ]; then
    # -p conserva el mtime: la detección de entradas "racy" de Git sigue funcionando.
    cp -p "$idx" "$tmp/index" && cp -p "$idx" "$tmp/index.staged" || { rm -rf "$tmp"; return 1; }
    it=$(GIT_INDEX_FILE="$tmp/index.staged" GIT_OBJECT_DIRECTORY="$tmp/obj" \
         git ${nf[@]+"${nf[@]}"} write-tree --missing-ok 2>/dev/null) || it=conflicted
  else
    it=$empty
  fi
  wt=$(cd "$QG_TOP" &&
       GIT_INDEX_FILE="$tmp/index" GIT_OBJECT_DIRECTORY="$tmp/obj" \
         git -c core.fsmonitor=false -c advice.addEmbeddedRepo=false ${nf[@]+"${nf[@]}"} \
         add -A -- . >/dev/null 2>"$tmp/err" &&
       GIT_INDEX_FILE="$tmp/index" GIT_OBJECT_DIRECTORY="$tmp/obj" \
         git ${nf[@]+"${nf[@]}"} write-tree --missing-ok 2>>"$tmp/err")
  local rc=$?
  if [ $rc -ne 0 ] || [ -z "$wt" ]; then
    [ "${QG_FP_QUIET:-0}" = 1 ] || qg_err "no se pudo calcular la huella: $(head -n 3 "$tmp/err" 2>/dev/null | tr '\n' ' ')"
    rm -rf "$tmp"; return 1
  fi
  rm -rf "$tmp"
  QG_FP="$fmt:$wt"
  if [ "$it" = conflicted ]; then QG_FP_INDEX=conflicted; else QG_FP_INDEX="$fmt:$it"; fi
  QG_HEAD=$(git rev-parse -q --verify HEAD 2>/dev/null) || QG_HEAD=unborn
  return 0
}

qg_index_state() {
  if [ "$QG_FP_INDEX" = conflicted ]; then echo conflicted
  elif [ "$QG_FP_INDEX" = "$QG_FP" ]; then echo matches
  else echo differs; fi
}

# ---------------------------------------------------------------- escritura atómica y lock

qg_atomic_write() {
  local dest=$1 content=$2 tmp
  tmp="$dest.tmp.$$.$RANDOM"
  printf '%s' "$content" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

QG_LOCKED=0
QG_LOCK_EPOCH=""

# Lee pid/host/epoch del dueño de un lock. Define L_pid, L_host, L_epoch (vacíos si no hay dueño legible).
qg_lock_owner() {
  local line
  L_pid=""; L_host=""; L_epoch=""
  [ -f "$1/owner" ] || return 1
  # El lock puede liberarse entre la comprobación y la lectura: se trata como "sin dueño".
  { while IFS= read -r line; do
      case $line in pid=*) L_pid=${line#pid=} ;; host=*) L_host=${line#host=} ;; epoch=*) L_epoch=${line#epoch=} ;; esac
    done; } 2>/dev/null < "$1/owner" || return 1
  qg_is_uint "$L_pid" && qg_is_uint "$L_epoch"
}

# Intenta retirar un lock abandonado. Solo se considera abandonado si:
#  - su dueño es de esta máquina, el pid ya no existe Y tiene al menos QG_LOCK_STALE_SEC segundos, o
#  - es de otra máquina o no tiene dueño legible y supera QG_LOCK_STALE_MIN minutos.
# Tras retirarlo (mv atómico) se comprueba que era exactamente el lock evaluado; si no, se restaura.
qg_lock_try_break() {
  local l=$1 stale=0 age g ep pd
  local stale_s="${QG_LOCK_STALE_SEC:-15}" stale_min="${QG_LOCK_STALE_MIN:-10}"
  if qg_lock_owner "$l"; then
    ep=$L_epoch; pd=$L_pid
    age=$(( $(qg_now_epoch) - L_epoch ))
    if [ "$L_host" = "$(qg_host)" ]; then
      [ "$age" -ge "$stale_s" ] && ! kill -0 "$L_pid" 2>/dev/null && stale=1
    else
      [ "$age" -ge $((stale_min * 60)) ] && stale=1
    fi
  else
    ep=""; pd=""
    [ -n "$(find "$l" -maxdepth 0 -mmin +"$stale_min" 2>/dev/null)" ] && stale=1
  fi
  [ $stale = 1 ] || return 1
  g="$l.stale.$$.$RANDOM"
  mv "$l" "$g" 2>/dev/null || return 1
  qg_lock_owner "$g"
  if [ "$L_epoch" = "$ep" ] && [ "$L_pid" = "$pd" ]; then
    rm -rf "$g"
    qg_err "lock abandonado recuperado (pid=${pd:-?})"
    return 0
  fi
  # Retiramos un lock distinto (recién creado por otro proceso): devolverlo si el nombre está libre.
  if [ ! -e "$l" ] && mv "$g" "$l" 2>/dev/null; then return 1; fi
  qg_err "aviso: conflicto al recuperar el lock; se conserva en $g"
  return 1
}

qg_lock() {
  local l="$QG_STATE/lock" tries=0 max="${QG_LOCK_TRIES:-900}"
  while :; do
    if mkdir "$l" 2>/dev/null; then
      QG_LOCK_EPOCH=$(qg_now_epoch)
      if printf 'pid=%s\nhost=%s\nepoch=%s\n' "$$" "$(qg_host)" "$QG_LOCK_EPOCH" > "$l/owner.tmp.$$" 2>/dev/null &&
         mv -f "$l/owner.tmp.$$" "$l/owner" 2>/dev/null; then
        QG_LOCKED=1
        trap 'qg_unlock' EXIT
        return 0
      fi
      # El directorio desapareció entre mkdir y la escritura del dueño: reintentar.
    else
      qg_lock_try_break "$l" && continue
    fi
    tries=$((tries + 1))
    [ "$tries" -ge "$max" ] && qg_die "$EX_STATE" "no se pudo obtener el lock de estado ($l)"
    sleep 0.05 2>/dev/null || sleep 1
  done
}

# Solo libera el lock si sigue siendo nuestro.
qg_unlock() {
  [ "$QG_LOCKED" = 1 ] || return 0
  local l="$QG_STATE/lock" g
  QG_LOCKED=0
  if qg_lock_owner "$l" && [ "$L_pid" = "$$" ] && [ "$L_epoch" = "$QG_LOCK_EPOCH" ]; then
    g="$l.release.$$.$RANDOM"
    mv "$l" "$g" 2>/dev/null && rm -rf "$g"
  else
    qg_err "aviso: el lock ya no era de este proceso; no se elimina"
  fi
}

# ---------------------------------------------------------------- registros

# Variables R_*: contenido de un registro.
qg_record_reset() {
  R_schema=""; R_check_id=""; R_run_id=""; R_status=""; R_exit_code=""; R_signal=""; R_error=""
  R_fp_start=""; R_fp_end=""; R_index_start=""; R_head_start=""; R_started_epoch=""; R_started_at=""
  R_finished_at=""; R_finished_epoch=""; R_duration_s=""; R_pid=""; R_host=""; R_cwd=""; R_argv=""
  R_argc=""; R_changed_during_run=""; R_timeout_s=""; R_qg_version=""
  R_baseline_ref=""; R_baseline_sha=""; R_baseline_format=""; R_baseline_result=""; R_baseline_reason=""
  R_baseline_known=""; R_baseline_new=""; R_baseline_fixed=""
}

# Claves de línea base (interfaz 4). Solo se escriben si el registro usa una línea base: los demás
# registros no cambian. Un qg de interfaz 3 las ignora y trata el registro por su exit_code (un exit
# distinto de 0 → failed): conservador, nunca un falso PASS.
QG_BL_KEYS="baseline_ref baseline_sha baseline_format baseline_result baseline_reason baseline_known baseline_new baseline_fixed"

qg_record_body() {
  local k v out=""
  for k in schema qg_version check_id run_id status exit_code signal error fp_start fp_end index_start \
           head_start changed_during_run started_at started_epoch finished_at finished_epoch duration_s \
           timeout_s pid host cwd argc argv; do
    v="R_$k"; v=${!v}   # expansión indirecta sobre nombres fijos de esta lista
    out="$out$k=$(qg_esc "$v")"$'\n'
  done
  if [ -n "$R_baseline_format" ]; then
    for k in $QG_BL_KEYS; do
      v="R_$k"; v=${!v}
      out="$out$k=$(qg_esc "$v")"$'\n'
    done
  fi
  printf '%s' "$out"
}

# Lee y valida un registro. 0 = válido, 1 = corrupto, 2 = esquema no soportado.
qg_record_read() {
  local file=$1 line key val
  qg_record_reset
  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in *=*) ;; *) return 1 ;; esac
    key=${line%%=*}; val=${line#*=}
    case $key in
      schema|qg_version|check_id|run_id|status|exit_code|signal|error|fp_start|fp_end|index_start|\
      head_start|changed_during_run|started_at|started_epoch|finished_at|finished_epoch|duration_s|\
      timeout_s|pid|host|cwd|argc|argv|baseline_ref|baseline_sha|baseline_format|baseline_result|\
      baseline_reason|baseline_known|baseline_new|baseline_fixed)
        printf -v "R_$key" '%s' "$val" ;;   # $key ya validada contra la lista fija
      *) [[ $key =~ ^[a-z][a-z0-9_]*$ ]] || return 1 ;;   # clave futura: se ignora
    esac
  done < "$file"
  if [ "$R_schema" != "$QG_SCHEMA" ]; then
    qg_is_uint "$R_schema" && return 2
    return 1
  fi
  [[ $R_check_id =~ $QG_ID_RE ]] || return 1
  [[ $R_run_id =~ $QG_RUNID_RE ]] || return 1
  qg_is_uint "$R_started_epoch" || return 1
  [[ $R_fp_start =~ $QG_FP_RE ]] || return 1
  case $R_status in
    running) ;;
    completed|timeout|interrupted|error)
      qg_is_uint "$R_exit_code" || return 1
      [[ $R_fp_end =~ $QG_FP_RE ]] || [ "$R_fp_end" = unknown ] || return 1 ;;
    rejected)
      [ "$R_fp_end" = "$R_fp_start" ] || return 1
      [[ $R_error =~ $QG_REASON_RE ]] || return 1 ;;
    *) return 1 ;;
  esac
  qg_record_baseline_ok || return 1
  return 0
}

# Coherencia de las claves de línea base: un registro manipulado no puede aprobar por esta vía.
qg_record_baseline_ok() {
  [ -z "$R_baseline_format$R_baseline_result" ] && return 0
  qg_bl_ref_ok "$R_baseline_ref" && [ -n "$R_baseline_format" ] || return 1
  [ -z "$R_baseline_reason" ] || [[ $R_baseline_reason =~ $QG_REASON_RE ]] || return 1
  case $R_baseline_result in
    "") [ "$R_status" = running ] || return 1 ;;
    inconclusive) [ -n "$R_baseline_reason" ] || return 1 ;;
    passed|failed)
      qg_is_uint "$R_baseline_known" && qg_is_uint "$R_baseline_new" && qg_is_uint "$R_baseline_fixed" || return 1
      [ "$R_status" = completed ] || return 1
      if [ "$R_baseline_result" = passed ]; then [ "$R_baseline_new" = 0 ] || return 1
      else [ "$R_baseline_new" != 0 ] || return 1; fi
      [ "$R_baseline_reason" = clean ] || [[ $R_baseline_sha =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || return 1 ;;
    *) return 1 ;;
  esac
  return 0
}

# Nombre: <secuencia por check, 9 díg.>-<epoch>-<pid>-<aleatorio>.rec → el orden léxico es el orden real.
qg_record_name_ok() { [[ $1 =~ ^[0-9]{9}-[0-9]{10}-[0-9]+-[0-9]+\.rec$ ]]; }

# Lista nombres de registros de un check, del más reciente al más antiguo.
qg_record_list() {
  local d=$1 f
  [ -d "$d" ] || return 0
  for f in "$d"/*.rec; do
    [ -e "$f" ] || continue
    f=${f##*/}
    printf '%s\n' "$f"
  done | LC_ALL=C sort -r
}

# Crea un registro nuevo con el contenido actual de R_* y devuelve su ruta. La secuencia se asigna
# bajo lock para que el orden entre ejecuciones del mismo check sea estricto.
qg_record_create() {
  local dir=$1 last seq=1 rec
  qg_lock
  last=$(qg_record_list "$dir" | head -n 1)
  if [ -n "$last" ] && qg_record_name_ok "$last"; then seq=$((10#${last%%-*} + 1)); fi
  rec="$dir/$(printf '%09d-%010d' "$seq" "$R_started_epoch")-$$-$RANDOM$RANDOM.rec"
  if ! qg_atomic_write "$rec" "$(qg_record_body)"; then qg_unlock; qg_err "no se pudo escribir el registro"; return 1; fi
  qg_unlock
  printf '%s' "$rec"
}

# ---------------------------------------------------------------- qg fingerprint

qg_cmd_fingerprint() {
  local json=0
  while [ $# -gt 0 ]; do
    case $1 in --json) json=1 ;; *) qg_usage "argumento desconocido: $1" ;; esac
    shift
  done
  qg_git_init
  qg_fp_compute || exit "$EX_STATE"
  if [ $json = 1 ]; then
    printf '{"schema":%s,"fingerprint":%s,"index_fingerprint":%s,"index":%s,"head":%s,"scope":"tracked+untracked-not-ignored"}\n' \
      "$QG_SCHEMA" "$(qg_json_str "$QG_FP")" "$(qg_json_str "$QG_FP_INDEX")" \
      "$(qg_json_str "$(qg_index_state)")" "$(qg_json_str "$QG_HEAD")"
  else
    printf '%s\n' "$QG_FP"
  fi
}

# ---------------------------------------------------------------- líneas base de diagnósticos

# Un typecheck con errores heredados solo puede pasar contra una línea base EXPLÍCITA de diagnósticos
# conocidos, comparada por firmas normalizadas (multiconjunto), nunca por el total. El exit code real
# del comando se conserva siempre; "pasó contra la línea base" se distingue en status.
#
# Archivo de línea base (versionado en el repo, entra en la huella):
#   # qg-baseline 1 format=typescript
#   <conteo>\t<firma>            una línea por firma, ordenada por firma (LC_ALL=C)
# Firma TypeScript: TSnnnn|<archivo relativo a la raíz, normalizado>|<mensaje con espacios colapsados>.
# En el archivo y el mensaje, '\' y '|' se escapan como '\\' y '\|': la firma es inequívoca.
# Las rutas se normalizan respecto a la raíz del repo: ejecuta tsc desde la raíz o usa una línea base
# por paquete (en monorepos, dos paquetes con la misma ruta relativa no deben compartir línea base).
# Línea y columna no entran en la firma: mover código no crea errores nuevos. Un mensaje que cambia
# (p. ej. un tipo renombrado) cuenta como error nuevo, a propósito: mejor un FAIL que revisar que un
# falso PASS. Solo se usa la primera línea de cada diagnóstico (las cadenas de mensajes no entran).
QG_BL_HEADER_TS="# qg-baseline 1 format=typescript"
QG_BL_MAX_NEW=200

# Ruta de línea base válida: relativa a la raíz del repo, sin '..' ni caracteres de control.
qg_bl_ref_ok() {
  local r=$1 re='[[:cntrl:]]'
  [ -n "$r" ] || return 1
  case $r in /*) return 1 ;; esac
  case "/$r/" in */../*) return 1 ;; esac
  [[ $r =~ $re ]] && return 1
  return 0
}

# Resuelve la línea base (siguiendo enlaces simbólicos) y exige que quede dentro del repo.
# Define QG_BL_FILE (ruta física) o QG_BL_ERR (baseline_missing|baseline_outside_repo|baseline_not_file).
qg_bl_locate() {
  local f="$QG_TOP/$1" t n=0 top dir
  QG_BL_FILE=""; QG_BL_ERR=baseline_missing
  top=$(cd -P -- "$QG_TOP" 2>/dev/null && pwd -P) || return 1
  while [ -L "$f" ]; do
    n=$((n + 1)); [ "$n" -le 40 ] || return 1
    t=$(readlink "$f") || return 1
    case $t in /*) f=$t ;; *) f="${f%/*}/$t" ;; esac
  done
  [ -e "$f" ] || return 1
  dir=$(cd -P -- "${f%/*}" 2>/dev/null && pwd -P) || return 1
  case "$dir/" in "$top/"*) ;; *) QG_BL_ERR=baseline_outside_repo; return 1 ;; esac
  [ -f "$f" ] || { QG_BL_ERR=baseline_not_file; return 1; }
  QG_BL_FILE="$dir/${f##*/}"; QG_BL_ERR=""
  return 0
}

# Analiza la salida de tsc. Escribe una firma por diagnóstico en $1 y define QG_TS_DIAG (diagnósticos)
# y QG_TS_UNREC (líneas no reconocidas). $2 = directorio del comando relativo a la raíz
# (git rev-parse --show-prefix); el resto, archivos de salida. Solo se reconoce la salida de tsc:
#   ruta(l,c): error TSnnnn: mensaje        ruta:l:c - error TSnnnn: mensaje   (--pretty, con ANSI)
#   tras un diagnóstico: líneas con sangría >= 2 (cadenas de mensajes, información relacionada,
#   marcos de código y subrayados de --pretty), el margen numérico de los marcos ("12 código", "...");
#   en cualquier punto: líneas en blanco, "Found N error(s)…" y la tabla "Errors  Files".
# Cualquier otra línea (otra herramienta, un envoltorio npm, una traza de Node) es irreconocible: la
# salida ajena a tsc nunca se ignora, así que --baseline debe envolver tsc directamente.
qg_ts_parse() {
  local sigs=$1 prefix=$2 ptop; shift 2
  ptop=$(cd -P -- "$QG_TOP" 2>/dev/null && pwd -P) || ptop=""
  QG_AWK_TOP=$QG_TOP QG_AWK_PTOP=$ptop QG_AWK_PREFIX=$prefix LC_ALL=C awk '
    function norm(p,   n, i, k, a, st, out) {
      if (substr(p, 1, 1) == "/") {
        if (top != "" && index(p, top "/") == 1) p = substr(p, length(top) + 2)
        else if (ptop != "" && index(p, ptop "/") == 1) p = substr(p, length(ptop) + 2)
        else return p                      # fuera del repo: se conserva tal cual
      } else p = prefix p
      n = split(p, a, "/"); k = 0
      for (i = 1; i <= n; i++) {
        if (a[i] == "" || a[i] == ".") continue
        if (a[i] == ".." && k > 0 && st[k] != "..") { k--; continue }
        st[++k] = a[i]
      }
      out = ""
      for (i = 1; i <= k; i++) out = out (i > 1 ? "/" : "") st[i]
      return out
    }
    function esc(v,   o, c, i, n) {   # escapa \ y | (sin depender de gsub con barras: portable)
      o = ""; n = length(v)
      for (i = 1; i <= n; i++) { c = substr(v, i, 1); if (c == "\\" || c == "|") o = o "\\"; o = o c }
      return o
    }
    BEGIN { top = ENVIRON["QG_AWK_TOP"]; ptop = ENVIRON["QG_AWK_PTOP"]; prefix = ENVIRON["QG_AWK_PREFIX"]
            u = 0; seen = 0; ansi = sprintf("%c", 27) "\\[[0-9;]*[A-Za-z]" }
    {
      l = $0
      sub(/\r$/, "", l)
      gsub(ansi, "", l)
      if (l ~ /^[ \t]*$/) next
      if (index(l, "error TS") > 0) {
        if (!match(l, /\([0-9]+,[0-9]+\): error TS[0-9]+: /) && !match(l, /:[0-9]+:[0-9]+ - error TS[0-9]+: /)) { u++; next }
        path = substr(l, 1, RSTART - 1); code = substr(l, RSTART, RLENGTH); msg = substr(l, RSTART + RLENGTH)
        sub(/^.*error TS/, "", code); sub(/: $/, "", code)
        if (path ~ /^[ \t]/) { u++; next }     # un diagnóstico empieza en la columna 1
        path = norm(path)
        gsub(/[ \t]+/, " ", msg); sub(/^ /, "", msg); sub(/ $/, "", msg)
        if (path == "" || msg == "") { u++; next }
        print "TS" code "|" esc(path) "|" esc(msg)
        seen = 1
        next
      }
      if (l ~ /^Found [0-9]+ errors?( in .+)?\.?$/) next
      if (l ~ /^Errors +Files$/) next
      if (seen && (l ~ /^(  |\t)/ || l ~ /^ ?[0-9]+( |$)/ || l ~ /^ *\.\.\.( |$)/)) next
      u++
    }
    END { print "#U " u }' "$@" > "$sigs.raw" || { rm -f "$sigs.raw"; return 1; }
  QG_TS_UNREC=$(sed -n '$s/^#U //p' "$sigs.raw")
  sed '$d' "$sigs.raw" > "$sigs" || { rm -f "$sigs.raw"; return 1; }
  rm -f "$sigs.raw"
  qg_is_uint "$QG_TS_UNREC" || return 1
  QG_TS_DIAG=$(wc -l < "$sigs" | tr -d ' ')
  return 0
}

# Compara un archivo de línea base con las firmas actuales (multiconjunto). Imprime en la primera línea
# "OK\t<known>\t<new>\t<fixed>", "CORRUPT" o "UNSUPPORTED"; después "<conteo>\t<firma>" por firma nueva.
#   new = Σ max(0, actual − base) · fixed = Σ max(0, base − actual) · known = Σ min(actual, base)
qg_bl_compare() {   # <archivo de línea base (no vacío)> <firmas actuales> <cabecera esperada>
  QG_AWK_HDR=$3 LC_ALL=C awk '
    BEGIN { hdr = ENVIRON["QG_AWK_HDR"]; bad = ""; seen = 0; havep = 0 }
    FNR == NR {
      if (bad != "") next
      sub(/\r$/, "")                       # checkout con CRLF (core.autocrlf)
      if (FNR == 1) {
        if ($0 == hdr) { seen = 1; next }
        if ($0 ~ /^# qg-baseline /) bad = "UNSUPPORTED"; else bad = "CORRUPT"
        next
      }
      t = index($0, "\t")
      if (t < 2) { bad = "CORRUPT"; next }
      c = substr($0, 1, t - 1); s = substr($0, t + 1)
      if (c !~ /^[1-9][0-9]*$/ || s == "" || index(s, "\t") > 0) { bad = "CORRUPT"; next }
      if (havep && s <= prev) { bad = "CORRUPT"; next }   # ordenada y sin firmas repetidas
      prev = s; havep = 1; base[s] = c + 0
      next
    }
    { cur[$0]++ }
    END {
      if (bad == "" && !seen) bad = "CORRUPT"
      if (bad != "") { print bad; exit 0 }
      known = 0; nw = 0; fixed = 0
      for (s in cur) {
        b = (s in base) ? base[s] : 0
        if (cur[s] > b) { nw += cur[s] - b; nl[s] = cur[s] - b; known += b } else known += cur[s]
      }
      for (s in base) { a = (s in cur) ? cur[s] : 0; if (base[s] > a) fixed += base[s] - a }
      print "OK\t" known "\t" nw "\t" fixed
      for (s in nl) print nl[s] "\t" s
    }' "$1" "$2"
}

# Evalúa la salida capturada de un `qg run --baseline`. Define R_baseline_* y QG_BL_NEW (firmas nuevas,
# máx. QG_BL_MAX_NEW líneas, ya escapadas). Nunca escribe la línea base.
# shellcheck disable=SC2034  # las variables R_* se leen por expansión indirecta en qg_record_body
qg_bl_analyze() {   # <exit> <ref> <prefijo> <base temporal> <salida>…
  local rc=$1 ref=$2 prefix=$3 tmp=$4 res line; shift 4
  R_baseline_known=""; R_baseline_new=""; R_baseline_fixed=""; R_baseline_sha=""; R_baseline_reason=""
  R_baseline_result=inconclusive; QG_BL_NEW=""
  if ! qg_ts_parse "$tmp.sig" "$prefix" "$@"; then R_baseline_reason=parse_error; return 0; fi
  if [ "$rc" = 0 ] && [ "$QG_TS_DIAG" = 0 ] && [ "$QG_TS_UNREC" = 0 ]; then
    # Sin diagnósticos: pasa por sí mismo, sin depender de la línea base (y sin su marca en status).
    R_baseline_result=passed; R_baseline_reason=clean; R_baseline_known=0; R_baseline_new=0; R_baseline_fixed=0
    return 0
  fi
  if ! qg_bl_locate "$ref"; then R_baseline_reason=$QG_BL_ERR; return 0; fi
  case $rc in 0|1|2) ;; *) R_baseline_reason=exit_code_unknown; return 0 ;; esac
  if [ "$QG_TS_UNREC" != 0 ]; then R_baseline_reason=unrecognized_output; return 0; fi   # antes que no_diagnostics
  if [ "$rc" != 0 ] && [ "$QG_TS_DIAG" = 0 ]; then R_baseline_reason=no_diagnostics; return 0; fi
  # Se compara una copia: el sha registrado es exactamente el del contenido comparado.
  if ! cat -- "$QG_BL_FILE" > "$tmp.base" 2>/dev/null; then R_baseline_reason=baseline_missing; return 0; fi
  if [ ! -s "$tmp.base" ]; then R_baseline_reason=baseline_corrupt; return 0; fi
  R_baseline_sha=$(git hash-object --no-filters -- "$tmp.base" 2>/dev/null) || R_baseline_sha=""
  [ -n "$R_baseline_sha" ] || { R_baseline_reason=hash_error; return 0; }
  qg_bl_compare "$tmp.base" "$tmp.sig" "$QG_BL_HEADER_TS" > "$tmp.cmp" || { R_baseline_reason=compare_error; return 0; }
  res=$(head -n 1 "$tmp.cmp")
  case $res in
    CORRUPT) R_baseline_reason=baseline_corrupt; R_baseline_sha=""; return 0 ;;
    UNSUPPORTED) R_baseline_reason=baseline_unsupported; R_baseline_sha=""; return 0 ;;
    OK*) ;;
    *) R_baseline_reason=compare_error; R_baseline_sha=""; return 0 ;;
  esac
  local tab=$'\t'
  res=${res#OK"$tab"}; R_baseline_known=${res%%"$tab"*}
  res=${res#*"$tab"};  R_baseline_new=${res%%"$tab"*}; R_baseline_fixed=${res#*"$tab"}
  if [ "$R_baseline_new" = 0 ]; then R_baseline_result=passed; else R_baseline_result=failed; fi
  while IFS= read -r line; do
    QG_BL_NEW="$QG_BL_NEW$(qg_esc "$line")"$'\n'
  done <<EOF_NEW
$(sed 1d "$tmp.cmp" | LC_ALL=C sort -t "$tab" -k 2 | head -n "$QG_BL_MAX_NEW")
EOF_NEW
  [ "$QG_BL_NEW" = $'\n' ] && QG_BL_NEW=""
  return 0
}

# Evalúa en status un registro completado, con huella sin cambios, que usó una línea base.
qg_eval_baseline() {
  local sha=""
  case $R_baseline_result in
    passed|failed)
      if [ "$R_baseline_reason" = clean ]; then
        if [ "$R_baseline_result" = passed ] && [ "$R_exit_code" = 0 ]; then C_result=passed; C_reason=""; C_bl=0
        else C_result=blocked; C_reason=baseline:inconsistent_record; fi
        return 0
      fi
      if [ "$R_baseline_format" != typescript ]; then C_result=blocked; C_reason=baseline:baseline_unsupported; return 0; fi
      case $R_exit_code in 0|1|2) ;; *) C_result=blocked; C_reason=baseline:exit_code_unknown; return 0 ;; esac
      if qg_bl_locate "$R_baseline_ref"; then sha=$(git hash-object --no-filters -- "$QG_BL_FILE" 2>/dev/null); fi
      # La línea base cambió (o desapareció) después de la ejecución: la evidencia ya no es vigente.
      if [ -z "$sha" ] || [ "$sha" != "$R_baseline_sha" ]; then C_result=stale; C_reason=baseline:baseline_changed
      elif [ "$R_baseline_result" = passed ]; then
        C_result=passed; C_reason="baseline:known=$R_baseline_known,fixed=$R_baseline_fixed"
      else C_result=failed; C_reason="baseline:new=$R_baseline_new"; fi ;;
    *) C_result=blocked; C_reason="baseline:${R_baseline_reason:-inconclusive}" ;;
  esac
  return 0
}

# ---------------------------------------------------------------- qg run

QG_CHILD=""; QG_SIG=""; QG_TRAPPED=0
qg_on_signal() {
  QG_TRAPPED=1
  if [ -z "$QG_SIG" ]; then
    QG_SIG=$1
    [ -n "$QG_CHILD" ] && kill -s "$1" -- "-$QG_CHILD" 2>/dev/null
  else
    [ -n "$QG_CHILD" ] && kill -KILL -- "-$QG_CHILD" 2>/dev/null   # segunda señal: forzar
  fi
}

qg_sig_num() { case $1 in HUP) echo 1 ;; INT) echo 2 ;; TERM) echo 15 ;; *) echo 0 ;; esac; }

# Ejecuta "$@" sin shell intermedio, en su propio grupo de procesos, con timeout.
# Define QG_RC, QG_TIMED_OUT, QG_SIG.
# Con QG_CAP=<directorio>, stdout y stderr del comando se capturan PRIMERO en <dir>/out y <dir>/err
# (un `cat` por flujo, cuyo exit se comprueba) y se muestran en la terminal al terminar (qg_cap_show).
# La captura no depende del lado de la terminal: un `| head` o una terminal cerrada no la truncan.
# QG_CAP_OK=1 solo si ambas copias terminaron con exit 0 (completas).
qg_exec() {
  local tmo=$1 grace=$2; shift 2
  local marker wd="" cdir="" t1="" t2=""
  marker=$(mktemp "${TMPDIR:-/tmp}/qg-tmo.XXXXXX") && rm -f "$marker"
  QG_SIG=""; QG_TIMED_OUT=0; QG_CAP_OK=0
  if [ -n "${QG_CAP:-}" ]; then
    if cdir=$(mktemp -d "${TMPDIR:-/tmp}/qg-cap.XXXXXX") && mkfifo "$cdir/o" "$cdir/e" &&
       : > "$QG_CAP/out" && : > "$QG_CAP/err"; then
      # Los lectores ignoran las señales: terminan al cerrarse la tubería (EOF) y no pierden el final.
      # La FIFO se abre antes que el archivo: si el archivo fallara, el comando recibe EPIPE y no se bloquea.
      ( trap '' INT TERM HUP; exec cat < "$cdir/o" > "$QG_CAP/out" ) &
      t1=$!
      ( trap '' INT TERM HUP; exec cat < "$cdir/e" > "$QG_CAP/err" ) &
      t2=$!
      QG_CAP_OK=1
    else
      [ -n "$cdir" ] && rm -rf "$cdir"; cdir=""
    fi
  fi
  trap 'qg_on_signal INT' INT
  trap 'qg_on_signal TERM' TERM
  trap 'qg_on_signal HUP' HUP
  set -m                                   # cada proceso en segundo plano: su propio grupo
  if [ "$QG_CAP_OK" = 1 ]; then
    ( exec "$@" ) </dev/null >"$cdir/o" 2>"$cdir/e" &
  else
    ( exec "$@" ) </dev/null &
  fi
  QG_CHILD=$!
  if [ "$tmo" -gt 0 ]; then
    ( trap - INT TERM HUP
      sleep "$tmo"
      : > "$marker"
      kill -TERM -- "-$QG_CHILD" 2>/dev/null
      sleep "$grace"
      kill -KILL -- "-$QG_CHILD" 2>/dev/null ) >/dev/null 2>&1 &
    wd=$!
  fi
  set +m
  while :; do
    QG_TRAPPED=0
    wait "$QG_CHILD"; QG_RC=$?
    [ "$QG_TRAPPED" = 1 ] || break         # wait interrumpido por una señal: seguir esperando
  done
  if [ -n "$wd" ]; then kill -- "-$wd" 2>/dev/null; wait "$wd" 2>/dev/null; fi
  if [ -e "$marker" ]; then QG_TIMED_OUT=1; rm -f "$marker"; fi
  if [ -n "$QG_SIG" ] || [ "$QG_TIMED_OUT" = 1 ]; then
    kill -KILL -- "-$QG_CHILD" 2>/dev/null   # restos del grupo (nietos) tras timeout/interrupción
  fi
  if [ -n "$cdir" ]; then
    # Espera acotada a que los lectores vacíen la tubería. Si un descendiente que escapó del grupo la
    # mantiene abierta, la copia queda incompleta (QG_CAP_OK=0) y no se usa para decidir nada.
    local i=0 s1 s2
    while [ "$i" -lt 50 ] && { kill -0 "$t1" 2>/dev/null || kill -0 "$t2" 2>/dev/null; }; do
      sleep 0.1 2>/dev/null || sleep 1
      i=$((i + 1))
    done
    if kill -0 "$t1" 2>/dev/null || kill -0 "$t2" 2>/dev/null; then
      QG_CAP_OK=0
      kill -KILL "$t1" "$t2" 2>/dev/null
    fi
    # Cada lector por separado: un fallo de escritura (disco lleno, límite) invalida la captura.
    wait "$t1" 2>/dev/null; s1=$?
    wait "$t2" 2>/dev/null; s2=$?
    [ "$s1" = 0 ] && [ "$s2" = 0 ] || QG_CAP_OK=0
    rm -rf "$cdir"
  fi
  trap - INT TERM HUP
  QG_CHILD=""
}

# Muestra en la terminal lo capturado (stdout → stdout, stderr → stderr). Un fallo del lado de la
# terminal (p. ej. `| head`) solo afecta a este `cat`, nunca a la captura ni a la decisión.
qg_cap_show() {
  [ -n "$1" ] || return 0
  [ -f "$1/out" ] && cat -- "$1/out" 2>/dev/null
  [ -f "$1/err" ] && cat -- "$1/err" >&2
  return 0
}

# Directorio temporal de captura: $QG_STATE/capture/<pid>.<aleatorio>. No usa el patrón *.tmp.*, así
# que `qg gc` no lo toca mientras el proceso vive; gc retira los de procesos muertos (ver qg_cmd_gc).
qg_cap_dir() {
  local d="$QG_STATE/capture"
  [ -L "$d" ] && qg_die "$EX_STATE" "'$d' es un enlace simbólico; se rechaza"
  [ -d "$d" ] || mkdir "$d" 2>/dev/null || [ -d "$d" ] || qg_die "$EX_STATE" "no se pudo crear '$d'"
  d="$d/$$.$RANDOM$RANDOM"
  mkdir "$d" || qg_die "$EX_STATE" "no se pudo crear '$d'"
  printf '%s' "$d"
}

# shellcheck disable=SC2034  # las variables R_* se leen por expansión indirecta en qg_record_body
qg_cmd_run() {
  local timeout="${QG_TIMEOUT:-3600}" grace="${QG_GRACE:-10}" run_id="${QG_RUN_ID:-unspecified}"
  local bl_ref="" bl_fmt="" bl_set=0
  while [ $# -gt 0 ]; do
    case $1 in
      --timeout) [ $# -ge 2 ] || qg_usage "--timeout requiere segundos"; timeout=$2; shift 2 ;;
      --grace)   [ $# -ge 2 ] || qg_usage "--grace requiere segundos"; grace=$2; shift 2 ;;
      --run-id)  [ $# -ge 2 ] || qg_usage "--run-id requiere un valor"; run_id=$2; shift 2 ;;
      --baseline) [ $# -ge 2 ] || qg_usage "--baseline requiere una ruta"; bl_ref=$2; bl_set=1; shift 2 ;;
      --baseline-format) [ $# -ge 2 ] || qg_usage "--baseline-format requiere un formato"; bl_fmt=$2; bl_set=1; shift 2 ;;
      --) qg_usage "falta <check-id> antes de --" ;;
      -*) qg_usage "opción desconocida: $1" ;;
      *) break ;;
    esac
  done
  [ $# -ge 1 ] || qg_usage "uso: qg run [--timeout S] [--run-id ID] [--baseline <ruta> --baseline-format typescript] <check-id> -- <comando> [args…]"
  if [ $bl_set = 1 ]; then
    [ -n "$bl_ref" ] && [ -n "$bl_fmt" ] || qg_usage "--baseline y --baseline-format se usan juntos"
    [ "$bl_fmt" = typescript ] || qg_usage "formato de línea base no admitido '$bl_fmt' (admitido: typescript)"
    qg_bl_ref_ok "$bl_ref" || qg_usage "--baseline: ruta relativa a la raíz del repositorio, sin '..' (recibido '$bl_ref')"
  fi
  local id=$1; shift
  [[ $id =~ $QG_ID_RE ]] || qg_usage "check-id inválido '$id' (permitido: [A-Za-z0-9._-], máx. 64)"
  [ "${1:-}" = "--" ] || qg_usage "falta -- entre <check-id> y el comando"
  shift
  [ $# -ge 1 ] || qg_usage "falta el comando"
  qg_is_uint "$timeout" || qg_usage "--timeout debe ser un entero >= 0 (0 = sin límite)"
  qg_is_uint "$grace" || qg_usage "--grace debe ser un entero >= 0"
  [[ $run_id =~ $QG_RUNID_RE ]] || qg_usage "run-id inválido '$run_id'"

  qg_git_init
  qg_state_init
  local dir; dir=$(qg_check_dir "$id")
  [ -d "$dir" ] || mkdir "$dir" 2>/dev/null || [ -d "$dir" ] || qg_die "$EX_STATE" "no se pudo crear '$dir'"

  qg_fp_compute || qg_die "$EX_STATE" "sin huella inicial no se registra evidencia; el comando no se ejecutó"
  local fp_start=$QG_FP

  qg_record_reset
  R_schema=$QG_SCHEMA; R_qg_version=$QG_VERSION; R_check_id=$id; R_run_id=$run_id; R_status=running
  R_fp_start=$fp_start; R_index_start=$(qg_index_state); R_head_start=$QG_HEAD
  R_started_epoch=$(qg_now_epoch); R_started_at=$(qg_now_iso); R_timeout_s=$timeout
  R_pid=$$; R_host=$(qg_host); R_cwd=$PWD; R_argc=$#; R_argv=$(qg_redact_argv "$@")
  local prefix="" cap=""
  QG_BL_NEW=""
  if [ $bl_set = 1 ]; then
    R_baseline_ref=$bl_ref; R_baseline_format=$bl_fmt
    prefix=$(git rev-parse --show-prefix 2>/dev/null) || prefix=""
  fi
  local rec; rec=$(qg_record_create "$dir") || exit "$EX_STATE"
  [ $bl_set = 1 ] && cap=$(qg_cap_dir)

  # Resolver el ejecutable sin shell: solo programas externos (sin funciones ni builtins).
  local err=""
  case $1 in
    */*) if [ ! -e "$1" ]; then err=not_found; elif [ -d "$1" ] || [ ! -x "$1" ]; then err=not_executable; fi ;;
    *)   type -P "$1" >/dev/null 2>&1 || err=not_found ;;
  esac

  local rc qg_exit
  QG_CAP_OK=0
  if [ -n "$err" ]; then
    R_status=error; R_error=$err
    if [ "$err" = not_found ]; then rc=127; else rc=126; fi
    R_exit_code=$rc; qg_exit=$rc
    R_fp_end=$fp_start; R_changed_during_run=0
    qg_err "'$1': $( [ "$err" = not_found ] && echo 'comando no encontrado' || echo 'no es ejecutable'); no se ejecutó nada"
  else
    QG_CAP=$cap qg_exec "$timeout" "$grace" "$@"
    rc=$QG_RC
    R_exit_code=$rc
    if [ -n "$QG_SIG" ]; then
      R_status=interrupted; R_signal=$QG_SIG; qg_exit=$((128 + $(qg_sig_num "$QG_SIG")))
    elif [ "$QG_TIMED_OUT" = 1 ]; then
      R_status=timeout; qg_exit=124
    else
      R_status=completed; qg_exit=$rc
    fi
    if qg_fp_compute; then R_fp_end=$QG_FP; else R_fp_end=unknown; fi
    if [ "$R_fp_end" = "$fp_start" ]; then R_changed_during_run=0; else R_changed_during_run=1; fi
  fi
  local bl_note=""
  if [ $bl_set = 1 ]; then
    if [ "$R_status" != completed ]; then
      R_baseline_result=inconclusive; R_baseline_reason=not_completed
    elif [ "$QG_CAP_OK" != 1 ]; then
      R_baseline_result=inconclusive; R_baseline_reason=capture_failed
    else
      qg_bl_analyze "$rc" "$bl_ref" "$prefix" "$cap/w" "$cap/out" "$cap/err"
    fi
    # Solo se conservan las firmas nuevas (nunca la salida cruda), junto al registro.
    if [ -n "$QG_BL_NEW" ]; then
      qg_atomic_write "$rec.new" "$QG_BL_NEW" || qg_err "aviso: no se pudieron guardar las firmas nuevas"
    fi
    bl_note=" baseline=$R_baseline_result"
    case $R_baseline_result in
      inconclusive) bl_note="$bl_note($R_baseline_reason)" ;;
      *) [ "$R_baseline_reason" = clean ] && bl_note="$bl_note(sin diagnósticos)" ||
           bl_note="$bl_note(known=$R_baseline_known new=$R_baseline_new fixed=$R_baseline_fixed)" ;;
    esac
  fi
  R_finished_epoch=$(qg_now_epoch); R_finished_at=$(qg_now_iso)
  R_duration_s=$((R_finished_epoch - R_started_epoch))
  qg_atomic_write "$rec" "$(qg_record_body)" || { [ -n "$cap" ] && rm -rf "$cap"; qg_die "$EX_STATE" "no se pudo escribir el registro final"; }
  if [ -n "$cap" ]; then qg_cap_show "$cap"; rm -rf "$cap"; fi

  local note="vigente"
  [ "$R_changed_during_run" = 1 ] && note="OBSOLETA: el contenido cambió durante la ejecución"
  [ "$R_fp_end" = unknown ] && note="INCOMPLETA: no se pudo calcular la huella final"
  qg_err "check=$id status=$R_status exit=$R_exit_code duración=${R_duration_s}s evidencia=$note$bl_note"
  if [ -n "$QG_BL_NEW" ]; then
    qg_err "diagnósticos nuevos respecto a $bl_ref (primeros 20; hasta $QG_BL_MAX_NEW en $rec.new):"
    printf '%s' "$QG_BL_NEW" | head -n 20 | sed 's/^/  /' >&2
  fi
  exit "$qg_exit"
}

# ---------------------------------------------------------------- qg require

# Archivo de requeridos: por sesión si hay run-id; si no, el del worktree.
qg_required_file() {
  if [ -n "$1" ]; then printf '%s/sessions/%s/required' "$QG_STATE" "$1"
  else printf '%s/required' "$QG_STATE"; fi
}

qg_required_read() {   # $1 = archivo. Rellena QG_REQUIRED (array). 0 ok, 1 inexistente, 2 corrupto
  QG_REQUIRED=()
  local f=$1 line schema=""
  [ -e "$f" ] || return 1
  [ -f "$f" ] && [ ! -L "$f" ] || return 2
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      schema=*) schema=${line#schema=} ;;
      check=*) [[ ${line#check=} =~ $QG_ID_RE ]] || return 2; QG_REQUIRED+=("${line#check=}") ;;
      "") ;;
      *) return 2 ;;
    esac
  done < "$f"
  [ "$schema" = "$QG_SCHEMA" ] || return 2
  return 0
}

qg_cmd_require() {
  local clear=0 ids=() i run_id="${QG_RUN_ID:-}"
  while [ $# -gt 0 ]; do
    case $1 in
      --clear) clear=1; shift ;;
      --run-id) [ $# -ge 2 ] || qg_usage "--run-id requiere un valor"; run_id=$2; shift 2 ;;
      -*) qg_usage "opción desconocida: $1" ;;
      *) [[ $1 =~ $QG_ID_RE ]] || qg_usage "check-id inválido '$1'"; ids+=("$1"); shift ;;
    esac
  done
  [ -z "$run_id" ] || [[ $run_id =~ $QG_RUNID_RE ]] || qg_usage "run-id inválido '$run_id'"
  qg_git_init
  qg_state_init
  local f; f=$(qg_required_file "$run_id")
  if [ $clear = 0 ] && [ ${#ids[@]} -eq 0 ]; then
    local r; qg_required_read "$f"; r=$?
    case $r in
      0) [ ${#QG_REQUIRED[@]} -gt 0 ] && printf '%s\n' "${QG_REQUIRED[@]}"; return 0 ;;
      1) qg_err "no hay verificaciones obligatorias declaradas"; return 0 ;;
      *) qg_die "$EX_STATE" "archivo de requeridos corrupto: $f (repáralo con: qg require --clear)" ;;
    esac
  fi
  if [ -n "$run_id" ]; then
    local d
    for d in "$QG_STATE/sessions" "$QG_STATE/sessions/$run_id"; do
      [ -L "$d" ] && qg_die "$EX_STATE" "'$d' es un enlace simbólico; se rechaza"
      [ -d "$d" ] || mkdir "$d" 2>/dev/null || [ -d "$d" ] || qg_die "$EX_STATE" "no se pudo crear '$d'"
    done
  fi
  qg_lock
  local body="schema=$QG_SCHEMA"$'\n'
  if [ $clear = 0 ]; then
    for i in "${ids[@]}"; do body="${body}check=$i"$'\n'; done
  fi
  qg_atomic_write "$f" "$body" || qg_die "$EX_STATE" "no se pudo escribir el archivo de requeridos"
  qg_unlock
}

# ---------------------------------------------------------------- qg status

# Evalúa un check respecto a la huella actual. Define C_result, C_reason, C_file, C_exit, C_run, C_when
# y, si el registro usó una línea base, C_bl=1 y C_bl_* (ref, format, known, new, fixed, result).
qg_eval_check() {
  local id=$1 filter=$2 d f r other=0 corrupt=0
  C_result=missing; C_reason=no_records; C_file=""; C_exit=""; C_run=""; C_when=""
  C_bl=0; C_bl_ref=""; C_bl_format=""; C_bl_known=""; C_bl_new=""; C_bl_fixed=""; C_bl_result=""
  d=$(qg_check_dir "$id")
  [ -d "$d" ] || return 0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if ! qg_record_name_ok "$f"; then corrupt=1; QG_CORRUPT=$((QG_CORRUPT + 1)); continue; fi
    qg_record_read "$d/$f"; r=$?
    if [ $r -ne 0 ] || [ "$R_check_id" != "$id" ]; then corrupt=1; QG_CORRUPT=$((QG_CORRUPT + 1)); continue; fi
    if [ -n "$filter" ] && [ "$R_run_id" != "$filter" ]; then continue; fi
    local about=0
    if [ "$R_fp_start" = "$QG_FP" ]; then about=1
    elif [ "$R_status" != running ] && [ "$R_fp_end" = "$QG_FP" ]; then about=1; fi
    if [ $about = 0 ]; then other=1; continue; fi
    C_file=$f; C_exit=$R_exit_code; C_run=$R_run_id; C_when=${R_finished_at:-$R_started_at}
    if [ -n "$R_baseline_format" ] && [ "$R_baseline_reason" != clean ]; then
      C_bl=1; C_bl_ref=$R_baseline_ref; C_bl_format=$R_baseline_format; C_bl_known=$R_baseline_known
      C_bl_new=$R_baseline_new; C_bl_fixed=$R_baseline_fixed; C_bl_result=$R_baseline_result
    fi
    case $R_status in
      running)
        C_result=incomplete
        if [ "$R_host" = "$(qg_host)" ] && qg_is_uint "$R_pid" && kill -0 "$R_pid" 2>/dev/null; then C_reason=running
        else C_reason=abandoned; fi ;;
      interrupted) C_result=incomplete; C_reason="interrupted:$R_signal" ;;
      timeout)     C_result=incomplete; C_reason=timeout ;;
      error)       C_result=blocked;    C_reason=$R_error ;;
      rejected)    C_result=blocked;    C_reason="rejected:$R_error" ;;
      completed)
        if [ "$R_fp_end" = unknown ]; then C_result=incomplete; C_reason=no_final_fingerprint
        elif [ "$R_fp_start" != "$R_fp_end" ]; then C_result=stale; C_reason=changed_during_run
        elif [ -n "$R_baseline_format" ]; then qg_eval_baseline
        elif [ "$R_exit_code" = 0 ]; then C_result=passed; C_reason=""
        else C_result=failed; C_reason="exit=$R_exit_code"; fi ;;
    esac
    break
  done <<EOF
$(qg_record_list "$d")
EOF
  if [ -z "$C_file" ] && [ $other = 1 ]; then C_result=stale; C_reason=code_changed; fi
  # Un registro ilegible podría ser el más reciente: nunca se aprueba un check con registros corruptos.
  if [ $corrupt = 1 ] && [ "$C_result" = passed ]; then C_result=incomplete; C_reason=corrupt_record; fi
  return 0
}

qg_rank() {
  case $1 in failed) echo 6 ;; blocked) echo 5 ;; incomplete) echo 4 ;; stale) echo 3 ;; missing) echo 2 ;; *) echo 1 ;; esac
}

qg_cmd_status() {
  local json=0 filter="${QG_RUN_ID:-}" req=() from="args"
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=1; shift ;;
      --run-id) [ $# -ge 2 ] || qg_usage "--run-id requiere un valor"; filter=$2; shift 2 ;;
      --require) [ $# -ge 2 ] || qg_usage "--require requiere un check-id"
                 [[ $2 =~ $QG_ID_RE ]] || qg_usage "check-id inválido '$2'"; req+=("$2"); shift 2 ;;
      *) qg_usage "argumento desconocido: $1" ;;
    esac
  done
  [ -z "$filter" ] || [[ $filter =~ $QG_RUNID_RE ]] || qg_usage "run-id inválido '$filter'"
  qg_git_init
  qg_fp_compute || exit "$EX_STATE"
  if [ ${#req[@]} -eq 0 ]; then
    # Con run-id solo cuentan los requisitos de ESA sesión (nunca se heredan los del worktree ni los de otra).
    local rf; rf=$(qg_required_file "$filter")
    if [ -n "$filter" ]; then from="session:$filter"; else from="file"; fi
    local r=1
    if [ -d "$QG_STATE" ]; then qg_required_read "$rf"; r=$?; fi
    [ $r = 2 ] && qg_die "$EX_STATE" "archivo de requeridos corrupto: $rf (repáralo con: qg require --clear)"
    [ $r = 0 ] && [ ${#QG_REQUIRED[@]} -gt 0 ] && req=("${QG_REQUIRED[@]}")
  fi

  QG_CORRUPT=0
  local overall=missing overall_reason="" best=0 id rk lines="" jchecks="" jbl="" blc=""
  if [ ${#req[@]} -eq 0 ]; then
    overall=missing; overall_reason=no_required_checks; best=2
  else
    best=1; overall=valid
    for id in "${req[@]}"; do
      qg_eval_check "$id" "$filter"
      rk=$(qg_rank "$C_result")
      if [ "$rk" -gt "$best" ]; then best=$rk; overall=$C_result; fi
      lines="$lines$(printf '  %-20s %-10s %s' "$id" "$C_result" "${C_reason:+($C_reason) }${C_exit:+exit=$C_exit }${C_run:+run=$C_run }$C_when")"$'\n'
      jbl=""
      if [ "$C_bl" = 1 ]; then
        jbl=",\"baseline\":{\"ref\":$(qg_json_str "$C_bl_ref"),\"format\":$(qg_json_str "$C_bl_format"),\"known\":${C_bl_known:-null},\"new\":${C_bl_new:-null},\"fixed\":${C_bl_fixed:-null},\"result\":$(qg_json_str "$C_bl_result")}"
        blc="$blc${blc:+,}$(qg_json_str "$id")"
      fi
      jchecks="$jchecks${jchecks:+,}{\"id\":$(qg_json_str "$id"),\"result\":$(qg_json_str "$C_result"),\"reason\":$(qg_json_str "$C_reason"),\"exit_code\":${C_exit:-null},\"run_id\":$(qg_json_str "$C_run"),\"record\":$(qg_json_str "$C_file"),\"finished_at\":$(qg_json_str "$C_when")$jbl}"
    done
  fi
  [ "$overall" = passed ] && overall=valid

  local idx; idx=$(qg_index_state)
  if [ $json = 1 ]; then
    printf '{"schema":%s,"qg_version":%s,"result":%s,"reason":%s,"fingerprint":%s,"index_fingerprint":%s,"index":%s,"head":%s,"required_from":%s,"run_id_filter":%s,"checks":[%s],"corrupt_records":%s,"baseline_checks":[%s]}\n' \
      "$QG_SCHEMA" "$(qg_json_str "$QG_VERSION")" "$(qg_json_str "$overall")" "$(qg_json_str "$overall_reason")" \
      "$(qg_json_str "$QG_FP")" "$(qg_json_str "$QG_FP_INDEX")" "$(qg_json_str "$idx")" "$(qg_json_str "$QG_HEAD")" \
      "$(qg_json_str "$from")" "$(if [ -n "$filter" ]; then qg_json_str "$filter"; else echo null; fi)" \
      "$jchecks" "$QG_CORRUPT" "$blc"
  else
    printf 'resultado: %s%s\n' "$overall" "${overall_reason:+ ($overall_reason)}"
    printf 'huella actual: %s\n' "$QG_FP"
    case $idx in
      matches) printf 'índice: coincide con el working tree\n' ;;
      differs) printf 'índice: DIFIERE del working tree (un commit incluiría contenido distinto del verificado)\n' ;;
      *) printf 'índice: con conflictos\n' ;;
    esac
    [ -n "$filter" ] && printf 'filtro run-id: %s\n' "$filter"
    if [ ${#req[@]} -gt 0 ]; then printf 'verificaciones obligatorias (%s):\n%s' "$from" "$lines"
    else printf 'no hay verificaciones obligatorias declaradas (qg require <id>… o --require)\n'; fi
    [ "$QG_CORRUPT" -gt 0 ] && printf 'registros corruptos o ilegibles: %s (qg gc los pone en cuarentena)\n' "$QG_CORRUPT"
  fi
  case $overall in
    valid) return 0 ;; failed) return 1 ;; blocked) return 2 ;; incomplete) return 3 ;;
    stale) return 4 ;; *) return 5 ;;
  esac
}

# ---------------------------------------------------------------- qg reject

# Registra que la última evidencia de un check sobre la huella actual NO es aceptable (p. ej. exit 0
# sin pruebas ejecutadas). Solo puede degradar: el check pasa a blocked hasta una nueva ejecución.
# shellcheck disable=SC2034  # las variables R_* se leen por expansión indirecta en qg_record_body
qg_cmd_reject() {
  local run_id="${QG_RUN_ID:-unspecified}" reason="" id=""
  while [ $# -gt 0 ]; do
    case $1 in
      --run-id) [ $# -ge 2 ] || qg_usage "--run-id requiere un valor"; run_id=$2; shift 2 ;;
      --reason) [ $# -ge 2 ] || qg_usage "--reason requiere un código"; reason=$2; shift 2 ;;
      -*) qg_usage "opción desconocida: $1" ;;
      *) [ -z "$id" ] || qg_usage "solo un check-id"; id=$1; shift ;;
    esac
  done
  [ -n "$id" ] || qg_usage "uso: qg reject [--run-id ID] <check-id> --reason <código>"
  [[ $id =~ $QG_ID_RE ]] || qg_usage "check-id inválido '$id'"
  [[ $reason =~ $QG_REASON_RE ]] || qg_usage "--reason obligatorio: [a-z0-9_-], p. ej. no_tests_executed"
  [[ $run_id =~ $QG_RUNID_RE ]] || qg_usage "run-id inválido '$run_id'"
  qg_git_init
  qg_state_init
  local dir; dir=$(qg_check_dir "$id")
  [ -d "$dir" ] || mkdir "$dir" 2>/dev/null || [ -d "$dir" ] || qg_die "$EX_STATE" "no se pudo crear '$dir'"
  qg_fp_compute || exit "$EX_STATE"
  qg_record_reset
  R_schema=$QG_SCHEMA; R_qg_version=$QG_VERSION; R_check_id=$id; R_run_id=$run_id; R_status=rejected
  R_error=$reason; R_fp_start=$QG_FP; R_fp_end=$QG_FP; R_changed_during_run=0
  R_index_start=$(qg_index_state); R_head_start=$QG_HEAD
  R_started_epoch=$(qg_now_epoch); R_started_at=$(qg_now_iso); R_finished_epoch=$R_started_epoch
  R_finished_at=$R_started_at; R_duration_s=0; R_pid=$$; R_host=$(qg_host); R_cwd=$PWD; R_argc=0
  qg_record_create "$dir" >/dev/null || exit "$EX_STATE"
  qg_err "check=$id evidencia descartada (motivo=$reason) para la huella actual"
}

qg_cmd_version() {
  case ${1:-} in
    --json) printf '{"name":"qg","version":%s,"schema":%s,"interface":%s}\n' \
              "$(qg_json_str "$QG_VERSION")" "$QG_SCHEMA" "$QG_INTERFACE" ;;
    "") printf 'qg %s (schema %s, interface %s)\n' "$QG_VERSION" "$QG_SCHEMA" "$QG_INTERFACE" ;;
    *) qg_usage "uso: qg version [--json]" ;;
  esac
}

# ---------------------------------------------------------------- qg show / gc

qg_cmd_show() {
  [ $# -le 1 ] || qg_usage "uso: qg show [<check-id>]"
  [ $# -eq 0 ] || [[ $1 =~ $QG_ID_RE ]] || qg_usage "check-id inválido '$1'"
  qg_git_init
  [ -d "$QG_STATE/records" ] || { qg_err "sin registros"; return 0; }
  qg_fp_compute || exit "$EX_STATE"
  local ids=() d f r mark
  if [ $# -eq 1 ]; then ids=("$1"); else
    for d in "$QG_STATE/records"/*; do [ -d "$d" ] && ids+=("${d##*/}"); done
  fi
  [ ${#ids[@]} -gt 0 ] || { qg_err "sin registros"; return 0; }
  printf '%-20s %-11s %-5s %-20s %-20s %s\n' CHECK STATUS EXIT INICIO RUN-ID "HUELLA (inicio→fin)"
  for d in "${ids[@]}"; do
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      qg_record_read "$QG_STATE/records/$d/$f"; r=$?
      if [ $r -ne 0 ]; then printf '%-20s %-11s %s\n' "$d" CORRUPTO "$f"; continue; fi
      mark=""; { [ "$R_fp_start" = "$QG_FP" ] || [ "$R_fp_end" = "$QG_FP" ]; } && mark=" *actual"
      printf '%-20s %-11s %-5s %-20s %-20s %s→%s%s\n' "$R_check_id" "$R_status" "${R_exit_code:--}" \
        "$R_started_at" "$R_run_id" "${R_fp_start#*:}" "${R_fp_end#*:}" "$mark" | sed -E 's/([0-9a-f]{12})[0-9a-f]+/\1/g'
    done <<EOF
$(qg_record_list "$QG_STATE/records/$d")
EOF
  done
}

qg_cmd_gc() {
  [ $# -eq 0 ] || qg_usage "uso: qg gc"
  qg_git_init
  [ -d "$QG_STATE" ] || return 0
  qg_lock
  local tmp_n=0 q_n=0 p_n=0 d f r n
  # temporales de escrituras interrumpidas (más de 10 min)
  while IFS= read -r f; do [ -n "$f" ] && rm -f "$f" && tmp_n=$((tmp_n + 1)); done <<EOF
$(find "$QG_STATE" -type f -name '*.tmp.*' -mmin +10 2>/dev/null)
EOF
  mkdir -p "$QG_STATE/quarantine"
  for d in "$QG_STATE/records"/*; do
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    n=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      qg_record_read "$d/$f"; r=$?
      if ! qg_record_name_ok "$f" || [ $r -eq 1 ]; then
        mv -f "$d/$f" "$QG_STATE/quarantine/${d##*/}.$f" && q_n=$((q_n + 1))
        [ -f "$d/$f.new" ] && mv -f "$d/$f.new" "$QG_STATE/quarantine/${d##*/}.$f.new"
        continue
      fi
      [ $r -eq 2 ] && continue                       # esquema futuro: no se toca
      n=$((n + 1))
      if [ $n -gt "$QG_KEEP_RECORDS" ] && [ "$R_status" != running ]; then
        rm -f "$d/$f" "$d/$f.new" && p_n=$((p_n + 1))
      fi
    done <<EOF
$(qg_record_list "$d")
EOF
    # Firmas nuevas (<registro>.new) cuyo registro ya no existe.
    for f in "$d"/*.rec.new; do
      [ -f "$f" ] && [ ! -e "${f%.new}" ] && rm -f "$f"
    done
  done
  # capturas de `run --baseline`/`baseline write` cuyo proceso ya no existe (y con más de 60 min, por si
  # el estado se comparte entre máquinas): las de un proceso vivo nunca se tocan.
  local c_n=0
  if [ -d "$QG_STATE/capture" ] && [ ! -L "$QG_STATE/capture" ]; then
    for d in "$QG_STATE/capture"/*; do
      [ -d "$d" ] && [ ! -L "$d" ] || continue
      n=${d##*/}; n=${n%%.*}
      qg_is_uint "$n" && kill -0 "$n" 2>/dev/null && continue
      [ -n "$(find "$d" -maxdepth 0 -mmin +60 2>/dev/null)" ] && rm -rf "$d" && c_n=$((c_n + 1))
    done
  fi
  # sesiones sin actividad desde hace más de QG_SESSION_DAYS días (30 por defecto)
  local s_n=0
  if [ -d "$QG_STATE/sessions" ] && [ ! -L "$QG_STATE/sessions" ]; then
    for d in "$QG_STATE/sessions"/*; do
      [ -d "$d" ] && [ ! -L "$d" ] || continue
      # -mtime es portable (GNU/BSD): ningún archivo de la sesión modificado en los últimos N días
      if [ -z "$(find "$d" -mtime -"${QG_SESSION_DAYS:-30}" 2>/dev/null | head -n 1)" ]; then
        rm -rf "$d" && s_n=$((s_n + 1))
      fi
    done
  fi
  qg_unlock
  qg_err "gc: temporales=$tmp_n cuarentena=$q_n podados=$p_n sesiones=$s_n capturas=$c_n"
}

# ---------------------------------------------------------------- qg baseline

# Crea (o con --replace, sustituye) una línea base a partir de la salida de un comando. No registra
# evidencia: la línea base es un archivo del repo que se revisa y se versiona como cualquier otro.
qg_cmd_baseline() {
  local sub=${1:-}; [ $# -gt 0 ] && shift
  local usage="uso: qg baseline write --format typescript --output <ruta> [--replace] [--timeout S] -- <comando> [args…]"
  [ "$sub" = write ] || qg_usage "$usage"
  local fmt="" outp="" replace=0 timeout="${QG_TIMEOUT:-3600}" grace="${QG_GRACE:-10}"
  while [ $# -gt 0 ]; do
    case $1 in
      --format)  [ $# -ge 2 ] || qg_usage "--format requiere un formato"; fmt=$2; shift 2 ;;
      --output)  [ $# -ge 2 ] || qg_usage "--output requiere una ruta"; outp=$2; shift 2 ;;
      --replace) replace=1; shift ;;
      --timeout) [ $# -ge 2 ] || qg_usage "--timeout requiere segundos"; timeout=$2; shift 2 ;;
      --) shift; break ;;
      *) qg_usage "argumento desconocido: $1 ($usage)" ;;
    esac
  done
  [ $# -ge 1 ] || qg_usage "$usage"
  [ "$fmt" = typescript ] || qg_usage "--format obligatorio; formato admitido: typescript"
  qg_bl_ref_ok "$outp" || qg_usage "--output: ruta relativa a la raíz del repositorio, sin '..' (recibido '$outp')"
  qg_is_uint "$timeout" || qg_usage "--timeout debe ser un entero >= 0 (0 = sin límite)"
  qg_is_uint "$grace" || qg_usage "QG_GRACE debe ser un entero >= 0"
  qg_git_init
  qg_state_init
  local dest="$QG_TOP/$outp" top pdir
  top=$(cd -P -- "$QG_TOP" 2>/dev/null && pwd -P) || qg_die "$EX_STATE" "no se pudo resolver la raíz del repositorio"
  pdir=$(cd -P -- "${dest%/*}" 2>/dev/null && pwd -P) || qg_die "$EX_STATE" "no existe el directorio de '$outp'"
  case "$pdir/" in "$top/"*) ;; *) qg_die "$EX_STATE" "'$outp' queda fuera del repositorio" ;; esac
  dest="$pdir/${dest##*/}"
  [ -L "$dest" ] && qg_die "$EX_STATE" "'$outp' es un enlace simbólico; se rechaza"
  if [ -e "$dest" ]; then
    [ -f "$dest" ] || qg_die "$EX_STATE" "'$outp' existe y no es un archivo regular"
    [ $replace = 1 ] || qg_die "$EX_STATE" "'$outp' ya existe; usa --replace para sustituirla (revisa el diff antes de versionarla)"
  fi
  case $1 in
    */*) [ -f "$1" ] && [ -x "$1" ] || qg_die 127 "'$1': no existe o no es ejecutable; no se ejecutó nada" ;;
    *)   type -P "$1" >/dev/null 2>&1 || qg_die 127 "'$1': comando no encontrado; no se ejecutó nada" ;;
  esac
  local cap rc why="" prefix
  cap=$(qg_cap_dir)
  prefix=$(git rev-parse --show-prefix 2>/dev/null) || prefix=""
  QG_CAP=$cap qg_exec "$timeout" "$grace" "$@"
  rc=$QG_RC
  qg_cap_show "$cap"
  if [ -n "$QG_SIG" ]; then why="interrumpido por $QG_SIG"
  elif [ "$QG_TIMED_OUT" = 1 ]; then why="superó el timeout (${timeout}s)"
  elif [ "$QG_CAP_OK" != 1 ]; then why="no se pudo capturar la salida completa"
  elif ! qg_ts_parse "$cap/w.sig" "$prefix" "$cap/out" "$cap/err"; then why="no se pudo analizar la salida"
  else
    case $rc in 0|1|2) ;; *) why="exit $rc fuera de los conocidos de tsc {0,1,2}" ;; esac
    [ -z "$why" ] && [ "$QG_TS_UNREC" != 0 ] && why="$QG_TS_UNREC línea(s) con 'error TS' no reconocidas"
    [ -z "$why" ] && [ "$rc" != 0 ] && [ "$QG_TS_DIAG" = 0 ] && why="exit $rc sin diagnósticos reconocibles"
  fi
  local body="" tab=$'\t' n_sig=0
  if [ -z "$why" ]; then
    body=$(LC_ALL=C awk '{ c[$0]++ } END { for (k in c) print c[k] "\t" k }' "$cap/w.sig" | LC_ALL=C sort -t "$tab" -k 2)
    [ -n "$body" ] && n_sig=$(printf '%s\n' "$body" | wc -l | tr -d ' ')
  fi
  local n_diag=${QG_TS_DIAG:-0}
  rm -rf "$cap"
  [ -z "$why" ] || qg_die "$EX_STATE" "no se escribe la línea base: $why"
  if [ -e "$dest" ] && [ $replace = 0 ]; then qg_die "$EX_STATE" "'$outp' apareció durante la ejecución; no se sobrescribe"; fi
  local tmp="$dest.tmp.$$.$RANDOM"
  { printf '%s\n' "$QG_BL_HEADER_TS"; [ -n "$body" ] && printf '%s\n' "$body"; } > "$tmp" &&
    chmod 644 "$tmp" && mv -f "$tmp" "$dest" || { rm -f "$tmp"; qg_die "$EX_STATE" "no se pudo escribir '$outp'"; }
  qg_err "línea base escrita en $outp: $n_diag diagnósticos, $n_sig firmas distintas (exit del comando: $rc)"
}

# ---------------------------------------------------------------- qg session (sesiones de Claude Code)

# session_id de Claude Code (UUID u otro identificador seguro). El run-id canónico es cc-<session_id>.
QG_SID_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,120}$'
QG_SOURCE_RE='^[a-z]{1,16}$'

qg_session_runid() { [[ $1 =~ $QG_SID_RE ]] || return 1; printf 'cc-%s' "$1"; }

qg_session_dir() {
  local d="$QG_STATE/sessions/$1" x
  for x in "$QG_STATE/sessions" "$d"; do
    [ -L "$x" ] && qg_die "$EX_STATE" "'$x' es un enlace simbólico; se rechaza"
    [ -d "$x" ] || mkdir "$x" 2>/dev/null || [ -d "$x" ] || qg_die "$EX_STATE" "no se pudo crear '$x'"
  done
  printf '%s' "$d"
}

# Lee el estado inicial de una sesión. Define SS_fp. 0 ok, 1 inexistente, 2 corrupto.
qg_session_read_start() {
  local f=$1 line
  SS_fp=""
  [ -e "$f" ] || return 1
  [ -f "$f" ] && [ ! -L "$f" ] || return 2
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      fingerprint=*) SS_fp=${line#fingerprint=} ;;
    esac
  done < "$f"
  [[ $SS_fp =~ $QG_FP_RE ]] || return 2
  return 0
}

qg_session_parse_runid() {   # --run-id obligatorio para start/info/stop
  [ -n "$1" ] || qg_usage "--run-id es obligatorio (usa: qg session id)"
  [[ $1 =~ $QG_RUNID_RE ]] || qg_usage "run-id inválido '$1'"
}

qg_cmd_session() {
  local sub=${1:-}; [ $# -gt 0 ] && shift
  local run_id="" source="unknown" json=0 hook_active=0 max="${QG_STOP_MAX_BLOCKS:-3}"
  if [ "$sub" = id ]; then
    [ $# -le 1 ] || qg_usage "uso: qg session id [<session_id>]"
    local sid="${1:-${CLAUDE_CODE_SESSION_ID:-}}"
    [ -n "$sid" ] || qg_die 1 "no hay identificador de sesión (CLAUDE_CODE_SESSION_ID vacío)"
    qg_session_runid "$sid" || qg_die 1 "identificador de sesión inválido"
    echo; return 0
  fi
  while [ $# -gt 0 ]; do
    case $1 in
      --run-id) [ $# -ge 2 ] || qg_usage "--run-id requiere un valor"; run_id=$2; shift 2 ;;
      --source) [ $# -ge 2 ] || qg_usage "--source requiere un valor"; source=$2; shift 2 ;;
      --max-blocks) [ $# -ge 2 ] || qg_usage "--max-blocks requiere un número"; max=$2; shift 2 ;;
      --stop-hook-active) hook_active=1; shift ;;
      --json) json=1; shift ;;
      *) qg_usage "argumento desconocido: $1" ;;
    esac
  done
  qg_session_parse_runid "$run_id"
  [[ $source =~ $QG_SOURCE_RE ]] || source=unknown
  qg_is_uint "$max" || qg_usage "--max-blocks debe ser un entero"
  qg_git_init
  case $sub in
    start)
      # Registra la huella inicial UNA vez por sesión: reanudar/compactar no la sobrescribe.
      qg_state_init
      local d; d=$(qg_session_dir "$run_id")
      local r; qg_session_read_start "$d/start"; r=$?
      if [ $r = 0 ]; then printf 'existing %s\n' "$SS_fp"; return 0; fi
      qg_fp_compute || exit "$EX_STATE"
      qg_lock
      qg_session_read_start "$d/start"; r=$?
      if [ $r = 0 ]; then qg_unlock; printf 'existing %s\n' "$SS_fp"; return 0; fi
      qg_atomic_write "$d/start" "schema=$QG_SCHEMA"$'\n'"fingerprint=$QG_FP"$'\n'"source=$source"$'\n'"started_at=$(qg_now_iso)"$'\n'"qg_version=$QG_VERSION"$'\n' \
        || { qg_unlock; qg_die "$EX_STATE" "no se pudo registrar el estado inicial"; }
      qg_unlock
      printf 'recorded %s\n' "$QG_FP" ;;
    info)
      local d="$QG_STATE/sessions/$run_id" r=1 marks=0 changed=unknown
      [ -d "$d" ] && [ ! -L "$d" ] && { qg_session_read_start "$d/start"; r=$?; }
      qg_fp_compute || exit "$EX_STATE"
      [ $r = 0 ] && { if [ "$SS_fp" = "$QG_FP" ]; then changed=false; else changed=true; fi; }
      local st_en st_es   # (sin `case` dentro de $(…): bash 3.2 no lo analiza bien)
      case $r in 0) st_en=recorded; st_es=registrado ;; 1) st_en=missing; st_es=ausente ;; *) st_en=corrupt; st_es=corrupto ;; esac
      [ -f "$d/stop-marks" ] && marks=$(grep -c . "$d/stop-marks" 2>/dev/null)
      if [ $json = 1 ]; then
        printf '{"run_id":%s,"start":%s,"start_fingerprint":%s,"fingerprint":%s,"changed":%s,"stop_blocks":%s}\n' \
          "$(qg_json_str "$run_id")" "$(qg_json_str "$st_en")" \
          "$(qg_json_str "$SS_fp")" "$(qg_json_str "$QG_FP")" "$( [ "$changed" = unknown ] && echo null || echo "$changed")" "${marks:-0}"
      else
        printf 'run-id: %s\ninicio: %s %s\nhuella actual: %s\ncambios en la sesión: %s\nbloqueos de Stop: %s\n' \
          "$run_id" "$st_es" "$SS_fp" "$QG_FP" "$changed" "${marks:-0}"
      fi ;;
    stop)
      qg_session_stop "$run_id" "$hook_active" "$max" ;;
    *) qg_usage "uso: qg session id|start|info|stop" ;;
  esac
}

# Decide si el hook Stop debe pedir una verificación. Imprime decision=allow|block y reason=<código>.
# Política (docs/hooks.md): solo bloquea si hubo cambios en la sesión y la evidencia de la sesión es
# stale o missing; nunca con stop_hook_active; como máximo una vez por huella y --max-blocks por sesión.
qg_session_stop() {
  local run_id=$1 hook_active=$2 max=$3 d r rc status marks=0
  d="$QG_STATE/sessions/$run_id"
  out() { printf 'decision=%s\nreason=%s\n' "$1" "$2"; }
  if [ "$hook_active" = 1 ]; then out allow stop_hook_active; return 0; fi
  if [ ! -d "$d" ] || [ -L "$d" ]; then out allow no_session_start; return 0; fi
  qg_session_read_start "$d/start"; r=$?
  [ $r = 1 ] && { out allow no_session_start; return 0; }
  [ $r = 2 ] && { out allow session_start_corrupt; return 0; }
  qg_fp_compute || { out allow fingerprint_error; return 0; }
  if [ "$QG_FP" = "$SS_fp" ]; then out allow no_changes; return 0; fi
  ( qg_cmd_status --run-id "$run_id" ) >/dev/null 2>&1; rc=$?
  case $rc in
    0) out allow evidence_valid; return 0 ;;
    1) out allow status_failed; return 0 ;;
    2) out allow status_blocked; return 0 ;;
    3) out allow status_incomplete; return 0 ;;
    4) status=stale ;;
    5) status=missing ;;
    *) out allow status_error; return 0 ;;
  esac
  qg_lock
  if [ -f "$d/stop-marks" ] && [ ! -L "$d/stop-marks" ]; then
    if grep -qFx -- "$QG_FP" "$d/stop-marks"; then qg_unlock; out allow already_blocked_for_fingerprint; return 0; fi
    marks=$(grep -c . "$d/stop-marks")
  fi
  if [ "$marks" -ge "$max" ]; then qg_unlock; out allow max_blocks_reached; return 0; fi
  local body=""
  [ -f "$d/stop-marks" ] && body=$(cat "$d/stop-marks")$'\n'
  qg_atomic_write "$d/stop-marks" "$body$QG_FP"$'\n' || { qg_unlock; out allow mark_error; return 0; }
  qg_unlock
  out block "$status"
}

# ---------------------------------------------------------------- qg hooks (activación voluntaria)

# Resuelve H_stop/H_pretool (on|off) y su origen. Precedencia: QG_DISABLE > QG_HOOKS > proyecto > off.
qg_hooks_resolve() {
  H_stop=off; H_pretool=off; H_src_stop=default; H_src_pretool=default; H_warn=""
  local v
  v=$(printf '%s' "${QG_DISABLE:-}" | tr 'A-Z' 'a-z')
  case $v in
    1|true|yes|on) H_src_stop=env:QG_DISABLE; H_src_pretool=env:QG_DISABLE; return 0 ;;
    ""|0|false|no|off) ;;
    *) H_warn="${H_warn}QG_DISABLE con valor no reconocido: se trata como desactivación; " 
       H_src_stop=env:QG_DISABLE; H_src_pretool=env:QG_DISABLE; return 0 ;;
  esac
  v=$(printf '%s' "${QG_HOOKS:-}" | tr 'A-Z' 'a-z')
  if [ -n "$v" ]; then
    case $v in
      0|false|no|off|none) H_src_stop=env:QG_HOOKS; H_src_pretool=env:QG_HOOKS; return 0 ;;
      1|true|yes|on|all) H_stop=on; H_pretool=on; H_src_stop=env:QG_HOOKS; H_src_pretool=env:QG_HOOKS; return 0 ;;
      *)
        if [[ $v =~ ^(stop|pretool)(,(stop|pretool))*$ ]]; then
          H_src_stop=env:QG_HOOKS; H_src_pretool=env:QG_HOOKS
          case ",$v," in *,stop,*) H_stop=on ;; esac
          case ",$v," in *,pretool,*) H_pretool=on ;; esac
          return 0
        fi
        H_warn="${H_warn}QG_HOOKS con valor no reconocido ('$v'): ignorado; " ;;
    esac
  fi
  qg_hooks_config
}

# Subconjunto YAML admitido en .agent/verification.yaml (cualquier otra forma invalida el bloque):
#   hooks:
#     stop: on|off|true|false
#     pretool: on|off|true|false
qg_hooks_config() {
  [ -n "${QG_TOP:-}" ] || return 0
  local f="$QG_TOP/.agent/verification.yaml" line in=0 bad=0 blocks=0 cs="" cp=""
  [ -e "$f" ] || return 0
  if [ -L "$f" ] || [ ! -f "$f" ]; then H_warn="${H_warn}$f no es un archivo regular: ignorado; "; return 0; fi
  local re_head='^hooks:[[:space:]]*(#.*)?$' re_inline='^hooks:' re_blank='^[[:space:]]*(#.*)?$'
  local re_top='^[^[:space:]]' re_kv='^[[:space:]]+(stop|pretool):[[:space:]]*(on|off|true|false)[[:space:]]*(#.*)?$'
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    if [ $in = 0 ]; then
      if [[ $line =~ $re_head ]]; then in=1; blocks=$((blocks + 1))
      elif [[ $line =~ $re_inline ]]; then bad=1; fi
      continue
    fi
    [[ $line =~ $re_blank ]] && continue
    if [[ $line =~ $re_top ]]; then
      in=0
      if [[ $line =~ $re_head ]]; then in=1; blocks=$((blocks + 1)); elif [[ $line =~ $re_inline ]]; then bad=1; fi
      continue
    fi
    if [[ $line =~ $re_kv ]]; then
      case ${BASH_REMATCH[1]} in
        stop) [ -n "$cs" ] && bad=1; cs=${BASH_REMATCH[2]} ;;
        pretool) [ -n "$cp" ] && bad=1; cp=${BASH_REMATCH[2]} ;;
      esac
    else
      bad=1
    fi
  done < "$f"
  [ $blocks -gt 1 ] && bad=1
  if [ $bad = 1 ]; then H_warn="${H_warn}bloque 'hooks:' de $f malformado: ignorado (hooks desactivados); "; return 0; fi
  case $cs in on|true) H_stop=on; H_src_stop=project ;; off|false) H_src_stop=project ;; esac
  case $cp in on|true) H_pretool=on; H_src_pretool=project ;; off|false) H_src_pretool=project ;; esac
  return 0
}

qg_cmd_hooks() {
  local sub=${1:-status}; [ $# -gt 0 ] && shift
  # Fuera de un repo Git los hooks no pueden obtener evidencia: se resuelven sin configuración de proyecto.
  QG_TOP=""
  if command -v git >/dev/null 2>&1 && [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
    QG_TOP=$(git rev-parse --show-toplevel 2>/dev/null)
  fi
  qg_hooks_resolve
  case $sub in
    enabled)
      [ $# -eq 1 ] || qg_usage "uso: qg hooks enabled <stop|pretool>"
      case $1 in
        stop) [ -n "$H_warn" ] && qg_err "$H_warn"; [ "$H_stop" = on ] ;;
        pretool) [ -n "$H_warn" ] && qg_err "$H_warn"; [ "$H_pretool" = on ] ;;
        *) qg_usage "hook desconocido '$1' (stop|pretool)" ;;
      esac ;;
    status)
      if [ "${1:-}" = --json ]; then
        printf '{"stop":{"enabled":%s,"source":%s},"pretool":{"enabled":%s,"source":%s},"repo":%s,"warnings":%s}\n' \
          "$( [ "$H_stop" = on ] && echo true || echo false)" "$(qg_json_str "$H_src_stop")" \
          "$( [ "$H_pretool" = on ] && echo true || echo false)" "$(qg_json_str "$H_src_pretool")" \
          "$(qg_json_str "${QG_TOP:-}")" "$(qg_json_str "$H_warn")"
      else
        printf 'stop:    %s (%s)\npretool: %s (%s)\n' "$H_stop" "$H_src_stop" "$H_pretool" "$H_src_pretool"
        [ -n "$QG_TOP" ] || printf 'repo: (no es un repositorio Git: sin configuración de proyecto)\n'
        [ -n "$H_warn" ] && printf 'avisos: %s\n' "$H_warn"
      fi
      return 0 ;;
    *) qg_usage "uso: qg hooks status [--json] | qg hooks enabled <stop|pretool>" ;;
  esac
}

# ---------------------------------------------------------------- classify

# Clasificación previa de efectos secundarios. Solo lee archivos: jamás ejecuta el comando ni
# ningún script. Gana la coincidencia más grave (1 read-only … 6 external); lo que no se puede
# inspeccionar es unknown (5, por encima de installs/writes), nunca read-only. El estado vive en
# globales (CL_*) para no depender de subshells. "depth" = niveles de indirección ya resueltos:
# se admite uno (npm run a → npm run b); más allá es unknown (indirect).
CL_RANK=0; CL_REASONS=""; CL_SOURCE=""
CL_PKG=""; CL_PKG_STATE=""; CL_SCRIPTS=""; CL_BODY=""
CL_PNPM_AUTO=""

cl_name() {
  case $1 in
    1) echo read-only ;; 2) echo writes-generated ;; 3) echo writes-source ;;
    4) echo installs-dependencies ;; 6) echo external-side-effects ;;
    *) echo unknown ;;
  esac
}

cl_add() {   # cl_add <rango> <código> <detalle>
  local line="$2: $3"
  [ "$1" -gt "$CL_RANK" ] && CL_RANK=$1
  case "$CL_REASONS" in
    *"$line"$'\n'*) ;;
    *) CL_REASONS="$CL_REASONS$line"$'\n' ;;
  esac
}
cl_src() {
  case "$CL_SOURCE" in *"$1"$'\n'*) ;; *) CL_SOURCE="$CL_SOURCE$1"$'\n' ;; esac
}

# Archivo más cercano subiendo desde $PWD hasta la raíz del repo (sin repo: solo $PWD). Es el que
# usaría la herramienta: nunca se salta un directorio intermedio para ir a la raíz.
cl_find() {
  local top d
  [ -f "$PWD/$1" ] && { printf '%s' "$PWD/$1"; return 0; }
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  top=$(cd "$top" 2>/dev/null && pwd -P) || return 1
  d=$(pwd -P)
  while [ -n "$d" ]; do
    [ -f "$d/$1" ] && { printf '%s' "$d/$1"; return 0; }
    [ "$d" = "$top" ] && break
    case $d in "$top"/*) d=${d%/*} ;; *) break ;; esac
  done
  return 1
}

# Extrae el objeto "scripts" (nivel superior) de package.json con awk POSIX.
# Salida: "OK" y una línea "nombre<TAB>valor" por script; "ERR" si el JSON no se lee con certeza.
cl_pkg_scripts() {
  LC_ALL=C awk '
    function ws() { while (pos <= n && index(" \t\r\n", substr(s, pos, 1))) pos++ }
    function bad() { print "ERR"; failed = 1; exit 2 }
    function str(   c, out, e, h, u) {
      if (substr(s, pos, 1) != "\"") bad()
      pos++; out = ""
      while (1) {
        if (pos > n) bad()
        c = substr(s, pos, 1)
        if (c == "\"") { pos++; return out }
        if (c == "\\") {
          e = substr(s, pos + 1, 1); pos += 2
          if (e == "n") out = out " ; "
          else if (e == "t" || e == "r" || e == "b" || e == "f") out = out " "
          else if (e == "\"" || e == "\\" || e == "/") out = out e
          else if (e == "u") {
            h = substr(s, pos, 4)
            if (h !~ /^00[0-7][0-9A-Fa-f]$/) bad()   # solo ASCII: cualquier otro \u es ilegible
            pos += 4; u = index("0123456789abcdef", tolower(substr(h, 3, 1))) - 1
            u = u * 16 + index("0123456789abcdef", tolower(substr(h, 4, 1))) - 1
            if (u == 10) out = out " ; "
            else if (u < 32 || u == 127) out = out " "
            else out = out sprintf("%c", u)
          } else bad()
        } else { out = out c; pos++ }
      }
    }
    function skipval(   c, d) {
      ws(); c = substr(s, pos, 1)
      if (c == "\"") { str(); return }
      if (c == "{" || c == "[") {
        pos++; d = 1
        while (d > 0) {
          if (pos > n) bad()
          c = substr(s, pos, 1)
          if (c == "\"") { str(); continue }
          if (c == "{" || c == "[") d++
          else if (c == "}" || c == "]") d--
          pos++
        }
        return
      }
      if (match(substr(s, pos), /^(true|false|null|-?[0-9][0-9.eE+-]*)/)) { pos += RLENGTH; return }
      bad()
    }
    function scripts(   k, v, c) {
      pos++; ws()
      if (substr(s, pos, 1) == "}") { pos++; return }
      while (1) {
        ws(); k = str(); ws()
        if (substr(s, pos, 1) != ":") bad()
        pos++; ws(); v = str()
        out = out k "\t" v "\n"
        ws(); c = substr(s, pos, 1); pos++
        if (c == "}") return
        if (c != ",") bad()
      }
    }
    { s = s $0 "\n" }
    END {
      n = length(s); pos = 1; ws()
      if (substr(s, pos, 1) != "{") bad()
      pos++; ws()
      if (substr(s, pos, 1) == "}") { pos++ }
      else while (1) {
        ws(); k = str(); ws()
        if (substr(s, pos, 1) != ":") bad()
        pos++; ws()
        if (k == "scripts") {
          if (substr(s, pos, 1) != "{") bad()
          out = ""   # clave duplicada: gana la última
          scripts()
        } else skipval()
        ws(); c = substr(s, pos, 1); pos++
        if (c == "}") break
        if (c != ",") bad()
      }
      ws(); if (pos <= n) bad()
      print "OK"; printf "%s", out
    }' "$1" 2>/dev/null
}

cl_load_pkg() {
  [ -n "$CL_PKG_STATE" ] && return 0
  local f out
  if ! f=$(cl_find package.json); then CL_PKG_STATE=missing; return 0; fi
  CL_PKG=$f
  out=$(cl_pkg_scripts "$f")
  case $out in
    OK*) CL_PKG_STATE=ok; CL_SCRIPTS=${out#OK}; CL_SCRIPTS=${CL_SCRIPTS#$'\n'} ;;
    *)   CL_PKG_STATE=error ;;
  esac
}

# Valor del último script con ese nombre en CL_SCRIPTS → CL_BODY; retorno 1 si no existe.
cl_lookup() {
  CL_BODY=$(CL_N=$1 awk -F '\t' '
    BEGIN { n = ENVIRON["CL_N"] }
    $1 == n { v = substr($0, length($1) + 2); f = 1 }
    END { if (f) print "F" v }' <<EOF
$CL_SCRIPTS
EOF
)
  [ -n "$CL_BODY" ] || return 1
  CL_BODY=${CL_BODY#F}
}

# ¿pnpm instala dependencias antes de ejecutar scripts? Deja el archivo (o "none") en CL_PNPM_AUTO.
cl_pnpm_auto() {
  [ -n "$CL_PNPM_AUTO" ] && return 0
  local f top
  top=$(git rev-parse --show-toplevel 2>/dev/null)
  for f in "$PWD/.npmrc" "$PWD/pnpm-workspace.yaml" ${top:+"$top/.npmrc" "$top/pnpm-workspace.yaml"}; do
    [ -f "$f" ] || continue
    if grep -Eq "^[[:space:]]*(verify-deps-before-run|verifyDepsBeforeRun)[[:space:]]*[=:][[:space:]]*[\"']?install[\"']?[[:space:]]*(#.*)?\$" "$f" 2>/dev/null; then
      CL_PNPM_AUTO=$f; return 0
    fi
  done
  CL_PNPM_AUTO=none
}

# Indicio por palabra completa (argumento suelto o parte de un nombre de script).
cl_word() {   # cl_word <palabra> <contexto>
  case $1 in
    deploy|publish|release|migrate|seed|push) cl_add 6 external "'$1' en $2" ;;
    install|i|add|ci) cl_add 4 install "'$1' en $2" ;;
    format) cl_add 3 format "'$1' en $2" ;;
    codegen|generate|build) cl_add 2 generate "'$1' en $2" ;;
  esac
}

# Indicios por nombre de script (build:release → build, release). "format:check" no cuenta como format.
cl_name_hints() {
  local w parts
  parts=$(printf '%s' "$1" | tr ':_./-' '     ')
  case " $parts " in *" check "*|*" verify "*) parts=${parts//format/} ;; esac
  for w in $parts; do
    case $w in
      deploy|publish|release|migrate|seed|push|format|codegen|generate|build)
        cl_word "$w" "el nombre del script '$1'" ;;
    esac
  done
}

# Texto de shell: lo separa en órdenes simples y clasifica cada una.
cl_text() {   # cl_text <depth> <texto>
  local lvl=$1 t=$2 seg
  case $t in *'`'*) cl_add 5 ambiguous "sustitución de comandos en: $t" ;; esac
  t=$(CL_T=$t awk '
    BEGIN {
      t = ENVIRON["CL_T"]; n = length(t); q = ""; out = ""
      for (i = 1; i <= n; i++) {
        c = substr(t, i, 1); d = substr(t, i, 2)
        if (c == "\\" && q != "\047") { out = out c substr(t, i + 1, 1); i++; continue }
        if (q != "") {
          if (c == q) q = ""
          if (c == ";" || c == "|" || c == "&") c = "\001"
          else if (c == "$" && q == "\"") out = out "\002"
          out = out c; continue
        }
        if (c == "\"" || c == "\047") { q = c; out = out c; continue }
        if (d == "&&" || d == "||") { out = out "\n"; i++; continue }
        if (c == "|" && substr(t, i - 1, 1) == ">") { out = out c; continue }   # >| es redirección
        if (c == ";" || c == "|") { out = out "\n"; continue }
        if (c == "&" && substr(t, i - 1, 1) != ">" && substr(t, i + 1, 1) != ">") { out = out "\n"; continue }
        if (c == "$") out = out "\002"
        out = out c
      }
      print out
    }')
  while IFS= read -r seg; do
    [ -n "${seg//[[:space:]]/}" ] || continue
    case $seg in *$'\002'*) cl_add 5 expansion "expansión de variable o comando que no se puede resolver en: ${seg//$'\002'/}" ;; esac
    set -f; set -- $seg; set +f
    cl_seg "$lvl" "$@"
  done <<EOF
$t
EOF
}

# Script de package.json: su cuerpo, y pre<s>/post<s> (npm los ejecuta solos).
cl_run_script() {   # cl_run_script <depth> <script>
  local lvl=$1 s=$2 p
  if [ "$lvl" -gt 1 ]; then cl_add 5 indirect "más de un nivel de indirección al llegar a '$s'"; return; fi
  cl_name_hints "$s"
  cl_load_pkg
  case $CL_PKG_STATE in
    missing) cl_add 5 not_found "no hay package.json"; return ;;
    error)   cl_add 5 parse_error "package.json no se puede leer con certeza"; cl_src "$CL_PKG"; return ;;
  esac
  cl_src "$CL_PKG"
  cl_lookup "$s" || { cl_add 5 script_inexistente "el script '$s' no está en package.json"; return; }
  cl_text "$((lvl + 1))" "$CL_BODY"
  for p in "pre$s" "post$s"; do
    if cl_lookup "$p"; then cl_text "$((lvl + 1))" "$CL_BODY"; fi
  done
}

cl_pm() {   # cl_pm <depth> <gestor> <args…>
  local lvl=$1 pm=$2 sub s a first=""; shift 2
  # Cambios de directorio o de paquete: el script no sería el del package.json que se lee aquí.
  for a in "$@"; do
    [ "$a" = -- ] && break
    case $a in
      -C|-C?*|--prefix|--prefix=*|--dir|--dir=*|--cwd|--cwd=*)
        cl_add 5 cwd_change "'$pm $a': el script se resuelve en otro directorio"; return ;;
      -w|-w?*|--workspace|--workspace=*|--workspaces|--workspaces=*|--filter|--filter=*|-F|-F?*|-r|--recursive)
        cl_add 5 workspace "'$pm $a': el script se resuelve en otro paquete del monorepo"; return ;;
      -*) ;;
      *) [ -n "$first" ] && continue
         first=$a
         case $a in
           workspace|workspaces) cl_add 5 workspace "'$pm $a': el script se resuelve en otro paquete del monorepo"; return ;;
           exec|x|dlx) break ;;   # lo que sigue son argumentos del comando ejecutado
         esac ;;
    esac
  done
  while [ $# -ge 1 ]; do case $1 in -*) shift ;; *) break ;; esac; done   # opciones globales
  [ $# -ge 1 ] || { cl_add 5 ambiguous "$pm sin subcomando"; return; }
  sub=$1; shift
  case $sub in
    run|run-script)
      s=${1:-}
      [ -n "$s" ] || { cl_add 5 ambiguous "$pm run sin nombre de script"; return; } ;;
    test|t|start) s=$sub ;;
    install|i|add|ci|update|up|upgrade|remove|rm|uninstall|link|rebuild|dedupe|create|init|dlx)
      cl_add 4 install "'$pm $sub' instala o modifica dependencias"; return ;;
    publish|audit|login|logout|deploy) cl_add 6 external "'$pm $sub' toca sistemas externos"; return ;;
    exec|x)
      if [ $# -ge 1 ]; then cl_seg "$lvl" "$@"; else cl_add 5 ambiguous "$pm $sub sin comando"; fi
      return ;;
    *)
      case $pm in
        npm) cl_add 5 ambiguous "subcomando de npm no analizado: $sub"; return ;;
      esac
      case $sub in
        list|ls|why|outdated|pack|store|config|cache|prune|patch|info|view|help|version|licenses|bin|root)
          cl_add 5 ambiguous "subcomando de $pm no analizado: $sub"; return ;;
      esac
      s=$sub ;;   # pnpm|yarn|bun <script>
  esac
  if [ "$pm" = pnpm ]; then
    cl_pnpm_auto
    if [ "$CL_PNPM_AUTO" != none ]; then
      cl_add 4 pnpm_auto_install "pnpm instala dependencias antes de ejecutar scripts (verify-deps-before-run=install en ${CL_PNPM_AUTO##*/})"
      cl_src "$CL_PNPM_AUTO"
    fi
  fi
  cl_run_script "$lvl" "$s"
}

cl_make() {   # cl_make <depth> <args…>
  local lvl=$1 t="" a mf body line d; shift
  for a in "$@"; do
    case $a in
      -f|-C|--file|--directory|-f?*|-C?*|--file=*|--directory=*)
        cl_add 5 ambiguous "make con $a: no se resuelve"; return ;;
      -*|*=*) ;;
      *) t=$a; break ;;
    esac
  done
  if [ -z "$t" ]; then cl_add 5 ambiguous "make sin objetivo explícito"; return; fi
  if [ "$lvl" -gt 1 ]; then cl_add 5 indirect "más de un nivel de indirección al llegar a '$t'"; return; fi
  mf=$(cl_find Makefile) || mf=$(cl_find makefile) || mf=$(cl_find GNUmakefile) || { cl_add 5 not_found "no hay Makefile"; return; }
  cl_src "$mf"
  cl_name_hints "$t"
  # "R<receta>" por cada línea con tabulador del objetivo y "D<prerequisitos>" de su línea "t: deps"
  body=$(CL_T=$t awk '
    BEGIN { t = ENVIRON["CL_T"] }
    /^\t/ { if (on) { r = substr($0, 2); sub(/^[@+-]+/, "", r); print "R" r }; next }
    /^[ \t]*$/ || /^#/ { next }
    { on = 0; i = index($0, ":")
      if (i > 0 && substr($0, i + 1, 1) != "=" && $0 !~ /^[ \t]/) {
        n = split(substr($0, 1, i - 1), a, /[ \t]+/)
        for (k = 1; k <= n; k++) if (a[k] == t) on = 1
        if (on) {
          found = 1; d = substr($0, i + 1); sub(/#.*/, "", d)
          if (index(d, ";")) { r = substr(d, index(d, ";") + 1); d = substr(d, 1, index(d, ";") - 1); print "R" r }
          print "D" d
        }
      } }
    END { if (!found) print "NOFOUND" }' "$mf")
  case $body in NOFOUND*) cl_add 5 script_inexistente "el objetivo '$t' no está en ${mf##*/}"; return ;; esac
  while IFS= read -r line; do
    case $line in
      D*) set -f
          for d in ${line#D}; do
            case $d in
              .PHONY|*%*|*'$'*) cl_add 5 ambiguous "prerequisito no resoluble: $d" ;;
              *) set +f; cl_make "$((lvl + 1))" "$d"; set -f ;;
            esac
          done
          set +f ;;
      R*) case ${line#R} in
            *'$(MAKE)'*|*'${MAKE}'*) cl_add 5 indirect "receta con \$(MAKE): ${line#R}" ;;
            *) cl_text "$((lvl + 1))" "${line#R}" ;;
          esac ;;
    esac
  done <<EOF
$body
EOF
}

cl_shellfile() {   # cl_shellfile <depth> <ruta>
  local lvl=$1 f=$2 line
  if [ ! -f "$f" ]; then cl_add 5 not_found "no existe el archivo '$f'"; return; fi
  cl_src "$f"
  if [ "$lvl" -gt 1 ]; then cl_add 5 indirect "más de un nivel de indirección al llegar a '$f'"; return; fi
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    [ -n "${line//[[:space:]]/}" ] || continue
    cl_text "$((lvl + 1))" "$line"
  done < "$f"
}

# Una orden simple ya separada en palabras.
cl_seg() {   # cl_seg <depth> <palabras…>
  local lvl=$1 tool w prev="" rd a noinst=0; shift
  while [ $# -gt 0 ]; do
    case $1 in
      [A-Za-z_]*=*) shift ;;
      if|then|else|elif|while|until|do|'!'|'{'|time|nohup|command|exec|env|cross-env) shift ;;
      *) break ;;
    esac
  done
  [ $# -ge 1 ] || return 0
  tool=${1##*/}
  # Banderas de escritura y redirecciones a archivos, en cualquier posición.
  for w in "$@"; do
    w=${w#[\"\']}; w=${w%[\"\']}
    case $w in
      --fix|--fix=*|--write|--write=*|-u|--update|--update=*|--update-*|--updateSnapshot|--updateSnapshot=*|--snapshot-update|--force-regen|--apply|--apply-*)
        cl_add 3 fix_flag "$w en los argumentos" ;;
      -w) case $tool in npm|pnpm|yarn|bun) ;; *) cl_add 3 fix_flag "-w en los argumentos" ;; esac ;;
      # Grupo de banderas cortas con u (-cu, -uw). Go no agrupa: sus banderas de un guion son
      # nombres largos (-run, -count, -timeout, -cpu); allí solo cuenta -u literal (arriba) y la
      # convención de archivos golden (go test ./... -update / -update-golden / -golden).
      -[A-Za-z]*)
        case $tool in
          go)
            case $w in
              -update|-update=*|-update-*|-update_*|-updategolden|-updategolden=*|-golden|-golden=*)
                cl_add 3 fix_flag "$w (regenera archivos golden) en los argumentos" ;;
            esac ;;
          *) [[ $w =~ ^-[A-Za-z]*u[A-Za-z]*$ ]] && cl_add 3 fix_flag "$w (incluye -u) en los argumentos" ;;
        esac ;;
    esac
    if [[ $w =~ ^[0-9\&]*\>[\>\|]?(.*)$ ]]; then
      rd=${BASH_REMATCH[1]}
      case $rd in /dev/null|\&*) rd="" ;; esac
      [ -z "$rd" ] || cl_add 2 redirect "redirección a $rd"
    elif [[ $prev =~ ^[0-9\&]*\>[\>\&\|]?$ ]]; then
      case $w in /dev/null|\&*|[0-9]|-) ;; *) cl_add 2 redirect "redirección a $w" ;; esac
    fi
    prev=$w
  done
  case $tool in
    npm|pnpm|yarn|bun) cl_pm "$lvl" "$tool" "${@:2}"; return ;;
    npx|pnpx|bunx)
      for a in "${@:2}"; do [ "$a" = "--no-install" ] && noinst=1; done
      if [ "$noinst" = 0 ]; then cl_add 4 npx "$tool sin --no-install puede descargar e instalar paquetes"; return; fi
      shift; while [ $# -gt 0 ]; do case $1 in -*) shift ;; *) break ;; esac; done
      if [ $# -ge 1 ]; then cl_seg "$lvl" "$@"; else cl_add 5 ambiguous "npx sin comando"; fi
      return ;;
    make|gmake) cl_make "$lvl" "${@:2}"; return ;;
    bash|sh|dash|zsh)
      shift
      case ${1:-} in
        -c) if [ $# -ge 2 ]; then cl_text "$lvl" "$2"; else cl_add 5 ambiguous "$tool -c sin cadena"; fi; return ;;
        -*|"") cl_add 5 ambiguous "$tool con opciones o sin archivo"; return ;;
        *) cl_shellfile "$lvl" "$1"; return ;;
      esac ;;
    docker|podman)
      case " $* " in *" push "*) cl_add 6 external "$tool push" ;; *) cl_add 5 unknown_tool "subcomando de $tool no analizado" ;; esac
      return ;;
    terraform|tofu|kubectl|helm)
      case " $* " in
        *" apply "*|*" destroy "*|*" delete "*|*" install "*|*" upgrade "*|*" rollout "*|*" patch "*)
          cl_add 6 external "$tool modifica infraestructura" ;;
        *) cl_add 5 unknown_tool "subcomando de $tool no analizado" ;;
      esac
      return ;;
    git)
      case ${2:-} in
        push|fetch|pull|clone) cl_add 6 external "git $2" ;;
        diff|status|log|show|ls-files|rev-parse|grep) cl_add 1 read_only_tool "git $2" ;;
        *) cl_add 5 unknown_tool "git ${2:-} no analizado" ;;
      esac
      return ;;
    curl|wget)
      case " $* " in
        *" -X POST "*|*" -X PUT "*|*" -X PATCH "*|*" -X DELETE "*|*" -XPOST "*|*" --request POST "*|*" --request PUT "*|*" --request PATCH "*|*" --request DELETE "*|*" -d "*|*" --data "*|*" --data-"*)
          cl_add 6 external "$tool con método que escribe en un servicio" ;;
        *) cl_add 5 unknown_tool "$tool: petición de red no analizada" ;;
      esac
      return ;;
    tsc)
      case " $* " in
        *" --noEmit "*|*" --noemit "*) cl_add 1 read_only_tool "tsc --noEmit" ;;
        *) cl_add 2 tsc_emit "tsc sin --noEmit puede emitir archivos" ;;
      esac
      for w in "$@"; do cl_word "$w" "los argumentos"; done
      return ;;
    prettier)
      case " $* " in
        *" --check "*|*" -c "*|*" --list-different "*|*" -l "*) cl_add 1 read_only_tool "prettier --check" ;;
        *" --write "*|*" -w "*) ;;   # ya registrado como escritura de fuentes
        *) cl_add 5 ambiguous "prettier sin --check ni --write" ;;
      esac
      for w in "$@"; do cl_word "$w" "los argumentos"; done
      return ;;
    cd|pushd|popd)
      cl_add 5 cwd_change "'$tool' cambia de directorio: lo que sigue no se resuelve con este package.json"; return ;;
    echo|printf|set|export|exit|true|false|:|test|'['|'[['|fi|done|read|cat|ls|grep|head|tail|wc|diff)
      cl_add 1 read_only_tool "$tool"; return ;;
    eslint|jest|vitest|mocha|ava|pytest|mypy|flake8|pylint|ruff|shellcheck|stylelint|rspec|phpunit|pyright|golangci-lint|tap|playwright|cypress|biome|oxlint)
      cl_add 1 read_only_tool "$tool"
      for w in "${@:2}"; do cl_word "$w" "los argumentos"; done
      return ;;
    go|cargo)
      case ${2:-} in
        test|vet|check|clippy|list|version|doc) cl_add 1 read_only_tool "$tool $2" ;;
        fmt|fix|mod|get|tidy|update) cl_add 3 writes_tool "$tool $2 modifica fuentes o manifiestos" ;;
        install) cl_add 4 install "$tool install" ;;
        build|generate) cl_add 2 generate "$tool $2" ;;
        publish) cl_add 6 external "$tool publish" ;;
        *) cl_add 5 unknown_tool "subcomando de $tool no analizado: ${2:-}" ;;
      esac
      for w in "${@:3}"; do cl_word "$w" "los argumentos"; done
      return ;;
  esac
  case $1 in
    *.sh) cl_shellfile "$lvl" "$1"; return ;;
    */*) if [ -f "$1" ]; then cl_add 5 unknown_tool "ejecutable no analizado: $1"; cl_src "$1"
         else cl_add 5 not_found "no existe '$1'"; fi
         return ;;
  esac
  case $1 in   # la orden es en sí un verbo de efecto (codegen, generate, build…)
    codegen|generate|build|format|deploy|publish|release|migrate|seed|push) cl_word "$1" "la orden"; return ;;
  esac
  for w in "${@:2}"; do cl_word "$w" "los argumentos"; done
  if command -v -- "$1" >/dev/null 2>&1; then cl_add 5 unknown_tool "herramienta no reconocida: $1"
  else cl_add 5 not_found "no se encuentra el comando '$1'"; fi
}

qg_cmd_classify() {
  local json=0 cls red r src first
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=1; shift ;;
      --) shift; break ;;
      *) qg_usage "opción desconocida para classify: $1" ;;
    esac
  done
  [ $# -ge 1 ] || qg_usage "uso: qg classify [--json] -- <comando> [args…]"
  CL_RANK=0; CL_REASONS=""; CL_SOURCE=""; CL_PKG=""; CL_PKG_STATE=""; CL_SCRIPTS=""; CL_PNPM_AUTO=""
  cl_seg 0 "$@"
  [ "$CL_RANK" -gt 0 ] || cl_add 5 ambiguous "no se pudo inspeccionar el comando"
  cls=$(cl_name "$CL_RANK"); red=$(qg_redact_argv "$@")
  if [ "$json" = 1 ]; then
    printf '{"class":%s,"reasons":[' "$(qg_json_str "$cls")"
    first=1
    while IFS= read -r r; do
      [ -n "$r" ] || continue
      [ "$first" = 1 ] || printf ','
      first=0; printf '%s' "$(qg_json_str "$r")"
    done <<EOF
$CL_REASONS
EOF
    printf '],"source":['
    first=1
    while IFS= read -r src; do
      [ -n "$src" ] || continue
      [ "$first" = 1 ] || printf ','
      first=0; printf '%s' "$(qg_json_str "$src")"
    done <<EOF
$CL_SOURCE
EOF
    printf '],"command":%s}\n' "$(qg_json_str "$red")"
  else
    printf 'clase: %s\ncomando: %s\n' "$cls" "$red"
    while IFS= read -r r; do [ -z "$r" ] || printf 'motivo: %s\n' "$r"; done <<EOF
$CL_REASONS
EOF
    while IFS= read -r src; do [ -z "$src" ] || printf 'origen inspeccionado: %s\n' "$src"; done <<EOF
$CL_SOURCE
EOF
  fi
  return 0
}

# ---------------------------------------------------------------- principal

qg_help() {
  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
  cat <<'EOF'

Códigos de salida de qg status: 0 valid · 1 failed · 2 blocked · 3 incomplete · 4 stale · 5 missing
qg run devuelve el código real del comando; 124 timeout; 126/127 no ejecutable/no encontrado;
128+n interrumpido por la señal n. Errores de qg: 64 uso, 65 estado/Git.

Líneas base (errores heredados): con --baseline, qg compara las firmas de los diagnósticos
(TSnnnn|archivo|mensaje, sin línea ni columna) con las del archivo, como multiconjunto, nunca por
el total. El check pasa solo si no hay diagnósticos nuevos (status lo marca baseline:known=K,fixed=F);
el exit real del comando se conserva. Salida irreconocible, exit fuera de {0,1,2} o línea base
ausente, corrupta o fuera del repo → blocked. qg run nunca escribe la línea base: usa qg baseline write.
--baseline debe envolver tsc directamente (no npm run, ni tsc && otra herramienta): cualquier línea
que no sea de tsc → blocked. Con --baseline la salida se muestra al terminar el comando. Las rutas
se normalizan respecto a la raíz: en monorepos, ejecuta desde la raíz o usa una línea base por paquete.

Clasificación previa: qg classify -- <cmd> dice si una verificación es read-only, writes-generated,
writes-source, installs-dependencies, external-side-effects o unknown, leyendo package.json (scripts),
Makefile, archivos de shell, .npmrc y pnpm-workspace.yaml; no ejecuta nada. Gana la coincidencia más
grave; lo que no se puede inspeccionar (script inexistente, indirección de más de un nivel, JSON ilegible)
es unknown, nunca read-only. La skill lo usa en Discover; qg run no cambia.
EOF
}

qg_main() {
  qg_parse_global "$@"
  set -- ${QG_ARGS[@]+"${QG_ARGS[@]}"}
  [ $# -ge 1 ] || { qg_help; exit "$EX_USAGE"; }
  local sub=$1; shift
  case $sub in
    fingerprint|fp) qg_cmd_fingerprint "$@" ;;
    run)            qg_cmd_run "$@" ;;
    require)        qg_cmd_require "$@" ;;
    status)         qg_cmd_status "$@" ;;
    show)           qg_cmd_show "$@" ;;
    gc)             qg_cmd_gc "$@" ;;
    help|-h|--help) qg_help ;;
    reject)         qg_cmd_reject "$@" ;;
    baseline)       qg_cmd_baseline "$@" ;;
    classify)       qg_cmd_classify "$@" ;;
    session)        qg_cmd_session "$@" ;;
    hooks)          qg_cmd_hooks "$@" ;;
    version|--version) qg_cmd_version "$@" ;;
    *) qg_usage "subcomando desconocido: $sub" ;;
  esac
}

qg_main "$@"
